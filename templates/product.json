    "custom_html_7mHehQ": {
      "type": "custom-html",
      "blocks": {
        "html_mjFhWe": {
          "type": "html",
          "settings": {
            "code": "<div id=\"recently-viewed-wrapper\">\n  <div id=\"recently-viewed-list\" class=\"product-grid--wrapper\"></div>\n</div>\n\n<script>\n  const path = window.location.pathname;\n  let handle = \"\";\n\n  // 日本語 or 英語でhandleを判別取得\n  if (path.includes(\"/ja-jp/products/\")) {\n    handle = path.split(\"/ja-jp/products/\")[1];\n  } else if (path.includes(\"/products/\")) {\n    handle = path.split(\"/products/\")[1];\n  }\n\n  // handleを確定\n  if (handle) {\n    handle = handle.split(\"/\")[0];\n\n    let viewed =\n      JSON.parse(localStorage.getItem(\"recently_viewed_simple\")) || [];\n    viewed = viewed.filter((h) => h !== handle);\n    viewed.unshift(handle);\n    if (viewed.length > 5) viewed = viewed.slice(0, 4);\n    localStorage.setItem(\"recently_viewed_simple\", JSON.stringify(viewed));\n  }\n\n  const handles =\n    JSON.parse(localStorage.getItem(\"recently_viewed_simple\")) || [];\n  const container = document.getElementById(\"recently-viewed-list\");\n\n  handles.forEach((h, i) => {\n    if (h === handle) return;\n\n    // 言語でfetch先URLを変える\n    const isJapanese = window.location.pathname.startsWith(\"/ja-jp\");\n    const fetchUrl = isJapanese\n      ? `/ja-jp/products/${h}.js`\n      : `/products/${h}.js`;\n    fetch(fetchUrl)\n      .then((res) => res.json())\n      .then((product) => {\n        const div = document.createElement(\"div\");\n        div.classList.add(\n          \"grid__item\",\n          \"large--one-quarter\",\n          \"medium--one-third\",\n          \"small--one-half\"\n        );\n\n        const productImgSrc = product.images[0] || \"\";\n        const formatPrice = (price) => {\n          if (!price) return \"\";\n          if (isJapanese) {\n            // 日本円表示（例：価格がすでに円の場合）\n            return `¥${Math.round(price / 100).toLocaleString()}`;\n          } else {\n            // ドル表示\n            return `$${(price / 100).toFixed(2)}`;\n          }\n        };\n\n        const price = formatPrice(product.price);\n\n        // カラーのオプション情報を取得\n        const colorOption = product.options.find(\n          (option) =>\n            option.name.toLowerCase() === \"color\" ||\n            option.name.toLowerCase() === \"colour\"\n        );\n\n        // カラーバリアントを収集\n        const colorVariants = [];\n        if (colorOption) {\n          const colorIndex = colorOption.position - 1;\n\n          // 重複のないカラーバリアントを収集\n          const uniqueColors = new Set();\n          product.variants.forEach((variant) => {\n            const color = variant.options[colorIndex];\n            if (!uniqueColors.has(color)) {\n              uniqueColors.add(color);\n              colorVariants.push({\n                id: variant.id,\n                color: color,\n                available: variant.available,\n                featured_image:\n                  variant.featured_image || product.featured_image,\n                url: `${product.url}?variant=${variant.id}`,\n              });\n            }\n          });\n        }\n\n        // スウォッチHTML部分を生成\n        let swatchesHtml = \"\";\n        if (colorVariants.length > 0) {\n          swatchesHtml = `\n          <div class=\"color-swatch--block\">\n            <div class=\"card-color-swatch--wrapper swiper swiper-backface-hidden swatch-no-slider swiper-initialized swiper-horizontal\">\n              <div class=\"swiper-wrapper\" aria-live=\"polite\">\n                ${colorVariants\n                  .map(\n                    (variant, index) => `\n                  <div data-variant-url=\"${variant.url}\" \n                       data-variant-price=\"$${(product.price / 100).toFixed(\n                         2\n                       )}\" \n                       data-color-value=\"${variant.color}\" \n                       data-product-title=\"${product.title}\" \n                       data-product-id=\"${product.id}\" \n                       class=\"card-color-swatch--inner swiper-slide ${\n                         index === 0 ? \"active swiper-slide-active\" : \"\"\n                       }\" \n                       role=\"group\" \n                       aria-label=\"${index + 1} / ${colorVariants.length}\" \n                       style=\"width: 24.75px; margin-right: 10px;\">\n                    <div class=\"card-color-swatch-input--wrapper\">\n                      <button \n                        class=\"card-color-swatch-input circle ${\n                          index === 0 ? \"swatch-selected\" : \"\"\n                        }\" \n                        aria-label=\"${product.title} | ${variant.color}\" \n                        style=\"background-color: ${variant.color.toLowerCase()};\">\n                        <span class=\"swatch-sold-out swatch-sold-out-background\"></span>\n                        <span class=\"swatch-sold-out swach-sold-out-foreground\"></span>\n                      </button>\n                    </div>\n                  </div>\n                `\n                  )\n                  .join(\"\")}\n              </div>\n              ${\n                colorVariants.length > 2\n                  ? `\n                <div class=\"swatch-swiper-button--next\" role=\"button\" aria-label=\"Next slide\">\n                  <svg viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\">\n                    <path d=\"M8 5L13 10L8 15\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                  </svg>\n                </div>\n              `\n                  : \"\"\n              }\n              <span class=\"swiper-notification\" aria-live=\"assertive\" aria-atomic=\"true\"></span>\n            </div>\n          </div>\n          <div id=\"aria-swatch-live-region-${\n            product.id\n          }\" class=\"visually-hidden\" aria-live=\"polite\"></div>\n        `;\n        }\n\n        div.innerHTML = `\n        <div class=\"grid-view-item text-align--left\">\n          <div>\n            <div class=\"grid-view-item-image\">\n              <a href=\"${product.url}\" title=\"${product.title}\" class=\"grid__image grid__image__match image-height--natural\" data-product-card-link=\"\">\n                <div class=\"responsive-image-wrapper\">\n                  <img \n                    loading=\"lazy\" \n                    class=\"theme-img js\" \n                    style=\"max-width: 1156px; max-height: 1738px; object-fit: cover; object-position: 50% 50% !important;\" \n                    alt=\"${product.title}\" \n                    data-product-card-image=\"\" \n                    width=\"1156\" \n                    height=\"1738\" \n                    src=\"${productImgSrc}\"\n                  />\n                </div>\n              </a>\n              <div class=\"product-card-image--bottom-wrapper\"></div>\n            </div>\n            <div class=\"product-grid--title product-grid--title-font-body\">\n              <a class=\"text-truncate--line text-link\" href=\"${product.url}\" data-product-card-link=\"\">${product.title}</a>\n            </div>\n            <div class=\"product-grid--price product-grid--price-font-body\">\n              <a href=\"${product.url}\" data-product-id=\"${product.id}\" tabindex=\"-1\">\n                <div class=\"product-price--regular\">${price}</div>\n              </a>\n            </div>\n            ${swatchesHtml}\n          </div>\n          <div class=\"quick-add-wrapper quick-shop--block text-link-animated\">\n            <a class=\"dynamic-section-button--grid-item btn--underlined quick-add-button-variants quick-add-button-variants-desktop\" data-product-card-link=\"\" tabindex=\"0\" href=\"${product.url}\">View more</a>\n          </div>\n        </div>\n      `;\n\n        container.appendChild(div);\n\n        // カラースウォッチボタンにイベントリスナーを追加（オプション）\n        const swatchButtons = div.querySelectorAll(\".card-color-swatch-input\");\n        swatchButtons.forEach((button) => {\n          button.addEventListener(\"click\", function () {\n            const variantDiv = this.closest(\".card-color-swatch--inner\");\n            const variantUrl = variantDiv.getAttribute(\"data-variant-url\");\n            if (variantUrl) window.location.href = variantUrl;\n          });\n        });\n      });\n  });\n</script>",
            "width": "100%",
            "margin_bottom": 0
          }
        }
      },
