      "type": "image-with-text",
      "settings": {
        "image": "shopify://shop_images/A.Shimus_03222025-981_1.jpg",
        "layout": "right",
        "title": "Perfect Fit Credit",
        "text": "<p></p><p>Because we’re serious about ensuring our designs fit you well,<br/>in the rare case you do make alterations to your A.SHIMUS products,<br/>we’ll send you a voucher for use against your next purchase.<br/><br/>Simply let us know.<br/><br/></p>",
        "text_alignment": "left",
