    "1645724424d6db0e5a": {
      "type": "accordion",
      "blocks": {
        "164572442464b4aa49-0": {
          "type": "tab_content",
          "settings": {
            "question": "What shipping options do you provide?",
            "open_by_default": false,
            "text": "<p>Visit <a href=\"/policies/shipping-policy\" title=\"Shipping Policy\">the Shipping page</a> for our current US Delivery services and costs.</p>",
            "page": ""
          }
        },
        "164572442464b4aa49-1": {
          "type": "tab_content",
          "settings": {
            "question": "What shipping provider do you use?",
            "open_by_default": false,
            "text": "<p>US orders are shipped with UPS, FedEx or DHL.</p>",
            "page": ""
          }
        },
        "164572442464b4aa49-2": {
          "type": "tab_content",
          "settings": {
            "question": "Can I change the address on my order once it has been placed?",
            "open_by_default": false,
            "text": "<p>Unfortunately, once orders have been placed the address cannot be amended. Please email us at <a href=\"mailto:customersupport@a-shimus.com\">customersupport@a-shimus.com</a> immediately and we will cancel your order. You will be able to create a new order with the correct address.</p>",
            "page": ""
          }
        },
        "tab_content_DTLKEY": {
          "type": "tab_content",
          "settings": {
            "question": "Can you deliver to a PO box?",
            "open_by_default": false,
            "text": "<p>Unfortunately, our courier cannot deliver to PO boxes as we require a signature for delivery.</p>",
            "page": ""
          }
        },
        "tab_content_bKUcR9": {
          "type": "tab_content",
          "settings": {
            "question": "Can I upgrade my delivery after I have placed my order?",
            "open_by_default": false,
            "text": "<p>Unfortunately, it is not possible to change your delivery choice once the order has been placed.</p>",
            "page": ""
          }
        },
        "tab_content_p7jiqt": {
          "type": "tab_content",
          "settings": {
            "question": "Can I track my order once it has been dispatched?",
            "open_by_default": false,
            "text": "<p>The shipper will email you full tracking details. Please use the waybill number to track your parcels destination.</p>",
            "page": ""
          }
        },
        "tab_content_AnmjMw": {
          "type": "tab_content",
          "settings": {
            "question": "I have a problem with my delivery, what should I do?",
            "open_by_default": false,
            "text": "<p>Please don’t hesitate to contact us at <a href=\"mailto:customersupport@a-shimus.com\">customersupport@a-shimus.com</a> .</p>",
            "page": ""
          }
        }
      },
