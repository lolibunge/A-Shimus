    "accordion_3LQCBX": {
      "type": "accordion",
      "blocks": {
        "tab_content_DfamPz": {
          "type": "tab_content",
          "settings": {
            "question": "I would like to provide feedback on my recent experience with A.SHIMUS, who should I contact?",
            "open_by_default": false,
            "text": "<p>We welcome customer feedback any time. Please contact us at <a href=\"mailto:customersupport@a-shimus.com\">customersupport@a-shimus.com</a> .</p>",
            "page": ""
          }
        },
        "tab_content_JJfthT": {
          "type": "tab_content",
          "settings": {
            "question": "The item I want is showing as \"out of stock\", how do I know if it will be restocked?",
            "open_by_default": false,
            "text": "<p>If the product is “Coming Soon” or due to be “Re-Stocked”, we will display this message in the Product Description. Click ‘Notify Me’ and register your email address. We will send you an email notification when this item is in stock and ready for purchase!</p><p>If there is no message in the Product Description, we may be sold out however we do recommend checking with us at <a href=\"mailto:customersupport@a-shimus.com\">customersupport@a-shimus.com</a> .</p>",
            "page": ""
          }
        },
        "tab_content_GtJYLV": {
          "type": "tab_content",
          "settings": {
            "question": "Where can I find your sizing information?",
            "open_by_default": false,
            "text": "<p>You can find our general sizing and measuring guide under the Size Guide online and at the back of the brochure however for specific garment measurements you can find this by clicking ‘SIZE GUIDE’ on the relevant product page.</p><p>Alternatively, you're welcome to contact us at <a href=\"mailto:customersupport@a-shimus.com\">customersupport@a-shimus.com</a> .</p>",
            "page": ""
          }
        },
        "tab_content_PUzgCw": {
          "type": "tab_content",
          "settings": {
            "question": "How do I wash my garment?",
            "open_by_default": false,
            "text": "<p>Our clothing is made from high quality fabrics and often require special care. Please ensure you follow the wash care instructions which can be found on the inside seam of the garment or the ‘FABRIC CARE’ section on the relevant product page.</p>",
            "page": ""
          }
        },
        "tab_content_RHgCwp": {
          "type": "tab_content",
          "settings": {
            "question": "How can I be added to the A.SHIMUS mailing list?",
            "open_by_default": false,
            "text": "<p>Scroll to the bottom of the A.SHIMUS home page and you will find a blank space to type your e-mail address, then click “SIGN UP” button. Alternatively you can contact us at <a href=\"mailto:customersupport@a-shimus.com\">customersupport@a-shimus.com</a>  with your Name, Address, Zip code and Phone Number and we will add you to our mailing list.</p>",
            "page": ""
          }
        },
        "tab_content_V94gtT": {
          "type": "tab_content",
          "settings": {
            "question": "How can I be removed from the A.SHIMUS mailing list?",
            "open_by_default": false,
            "text": "<p>Please submit your details using the form on this page to unsubscribe from our mailing list. Please allow up to 6 weeks for this request to take effect due to processing lead times with the mailing distribution provider.</p>",
            "page": ""
          }
        }
      },
