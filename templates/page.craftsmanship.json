          }
        },
        "richtext_XG6bJE": {
          "type": "richtext",
          "settings": {
            "text": "<p>At A.SHIMUS, Japanese craftsmanship is at the heart of everything we make. Our workwear is produced in Japan by skilled artisans who bring generations of expertise to fabric sourcing, pattern-making, and garment construction. We work closely with trusted Japanese manufacturers known for their precision, attention to detail, and commitment to quality, ensuring every piece is thoughtfully made, responsibly produced, and built to last. By combining traditional Japanese tailoring techniques with modern design for petite women, A.SHIMUS creates refined workwear that delivers exceptional fit, comfort, and longevity for professional life.</p><p></p><p> </p>",
            "text_size": 14,
            "text_bottom_spacing": 40
          }
        }
