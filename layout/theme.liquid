  <script>
    (function() {
      'use strict';
      
      // PART 1: Save and modify links on collection page
      if (window.location.pathname.includes('/collections/')) {
        var pathParts = window.location.pathname.split('/').filter(function(part) { return part; });
        var collectionIndex = pathParts.indexOf('collections');
        
        if (collectionIndex !== -1 && pathParts[collectionIndex + 1]) {
          var collectionHandle = pathParts[collectionIndex + 1];
          
          // Modify ALL product links to add the parameter
          function addCollectionToLinks() {
            var productLinks = document.querySelectorAll('a[href*="/products/"]');
            
            for (var i = 0; i < productLinks.length; i++) {
              var link = productLinks[i];
              var currentHref = link.getAttribute('href');
              
              // Only modify if it doesn't already have the collection parameter
              if (currentHref && !currentHref.includes('collection=')) {
                var separator = currentHref.includes('?') ? '&' : '?';
                var newHref = currentHref + separator + 'collection=' + collectionHandle;
                link.setAttribute('href', newHref);
              }
            }
          }
          
          // Execute immediately
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', addCollectionToLinks);
          } else {
            addCollectionToLinks();
          }
          
          // Execute after delays to catch dynamically loaded content
          setTimeout(addCollectionToLinks, 100);
          setTimeout(addCollectionToLinks, 500);
          setTimeout(addCollectionToLinks, 1000);
          
          // Use MutationObserver to catch dynamically added links
          var observer = new MutationObserver(function(mutations) {
            addCollectionToLinks();
          });
          
          observer.observe(document.body, {
            childList: true,
            subtree: true
          });
          
          // Save to sessionStorage as backup
          document.addEventListener('click', function(e) {
            var target = e.target;
            var link = target.closest ? target.closest('a[href*="/products/"]') : null;
            
            // Fallback for browsers without closest
            if (!link && target.tagName === 'A' && target.href && target.href.includes('/products/')) {
              link = target;
            } else if (!link) {
              var parent = target.parentElement;
              while (parent && parent.tagName !== 'BODY') {
                if (parent.tagName === 'A' && parent.href && parent.href.includes('/products/')) {
                  link = parent;
                  break;
                }
                parent = parent.parentElement;
              }
            }
            
            if (link) {
              sessionStorage.setItem('last_collection', collectionHandle);
            }
          });
        }
      }
      
      // PART 2: Update breadcrumb on product page
      if (window.location.pathname.includes('/products/')) {
        function updateBreadcrumb() {
          // Try to get the parameter from URL
          var collectionHandle = null;
          
          // Parse URL parameters manually for better compatibility
          var search = window.location.search;
          if (search) {
            var params = search.substring(1).split('&');
            for (var i = 0; i < params.length; i++) {
              var pair = params[i].split('=');
              if (pair[0] === 'collection') {
                collectionHandle = decodeURIComponent(pair[1]);
                break;
              }
            }
          }
          
          // If no parameter, use sessionStorage
          if (!collectionHandle) {
            collectionHandle = sessionStorage.getItem('last_collection');
          }
          
          if (collectionHandle) {
            var collectionItem = document.querySelector('[data-collection-item]');
            var collectionLink = document.querySelector('[data-collection-link]');
            var collectionTitle = document.querySelector('[data-collection-title]');
            
            if (collectionLink && collectionTitle) {
              // Show the element if it was hidden
              if (collectionItem) {
                collectionItem.style.display = '';
              }
              
              // Update URL
              collectionLink.href = '/collections/' + collectionHandle;
              
              // Update title (format the handle)
              var words = collectionHandle.split('-');
              var formattedWords = [];
              for (var i = 0; i < words.length; i++) {
                formattedWords.push(words[i].charAt(0).toUpperCase() + words[i].slice(1));
              }
              var formattedTitle = formattedWords.join(' ');
              
              collectionTitle.textContent = formattedTitle;
              collectionLink.title = formattedTitle;
            }
          }
        }
        
        // Execute when DOM is ready with multiple fallbacks
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', updateBreadcrumb);
        } else {
          updateBreadcrumb();
        }
        
        // Execute with multiple delays for safety
        setTimeout(updateBreadcrumb, 50);
        setTimeout(updateBreadcrumb, 100);
        setTimeout(updateBreadcrumb, 300);
        setTimeout(updateBreadcrumb, 500);
      }
    })();
    </script>
