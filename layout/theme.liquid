  <!-- Wishlist 動作コード START -->
        
  <script>
  if (!customElements.get('swym-header-icon')) {
    class SwymHeaderIcon extends HTMLElement {
      constructor() {
        super();
        if (!window.SwymCallbacks) window.SwymCallbacks = [];
        window.SwymCallbacks.push(this._initializeSwymButton.bind(this));
      }
      async _initializeSwymButton(swat) {
        this.button = this.querySelector('button');
        if (this.button) {
          this.button.addEventListener('click', () => {
            swat.ui.open();
          });
        }
        this.counter = this.querySelector(".swym-wishlist-header-counter");
        this.heart = document.querySelector("svg.swym-svg");
        if (this.counter) {
          const heart = this.heart;
          const counter = this.counter;
          counter.style.display = "none";
          async function getListsData() {
            return new Promise(async (resolve, reject) => {
              swat.fetchLists({
                callbackFn: data => resolve(data),
                onError: error => reject(error)
              });
            });
          }
          const listData = await getListsData();
          let products = [];
          for (const list of listData) {
            for (const product of list.listcontents) {
              products.push(product);
            }
          }
          if(products.length !== 0) {
            counter.style.display = "";
            heart.setAttribute('fill', '#371313');
            this.counter.innerHTML = products.length;
            swat.evtLayer.addEventListener(swat.JSEvents.addedToWishlist, () => {
              const counterCount = +counter.innerHTML;
              counter.innerHTML = counterCount + 1;
            });
            swat.evtLayer.addEventListener(swat.JSEvents.removedFromWishlist, () => {
              const counterCount = +counter.innerHTML;
              if (counterCount > 0) counter.innerHTML = counterCount - 1;
            });
          }
        }
      }
    }
    customElements.define('swym-header-icon', SwymHeaderIcon);
  }

  //検索条件一部削除
  document.addEventListener("DOMContentLoaded", function () {
  const sortBy = document.querySelector("#SortBy");
  if (sortBy) {
    ["title-ascending", "title-descending", "created-ascending"].forEach(value => {
      const option = sortBy.querySelector(`option[value="${value}"]`);
      if (option) option.remove();
    });
  }
});
// Wishlist 動作コード END

// Inicializar cada swiper de producto individualmente
function initProductSwipers() {
  const productSwipers = document.querySelectorAll('.grid-view-item-image-swiper');
  
  productSwipers.forEach((swiperEl) => {
    // Verificar si ya fue inicializado
    if (swiperEl.swiper) return;
    
    const imageCount = parseInt(swiperEl.dataset.imageCount) || 0;
    
    // Solo inicializar swiper si hay más de 1 imagen
    if (imageCount > 1) {
      const pagination = swiperEl.querySelector('.grid-view-item-image-pagination');
      
      const productSwiper = new Swiper(swiperEl, {
        slidesPerView: 1,
        spaceBetween: 0,
        loop: false,
        touchEventsTarget: 'wrapper',
        nested: true,
        resistance: true,
        resistanceRatio: 0,
        allowTouchMove: true,
        preventInteractionOnTransition: false,
        pagination: {
          el: pagination,
          type: 'bullets',
          clickable: true,
          dynamicBullets: false,
          bulletClass: 'swiper-pagination-bullet',
          bulletActiveClass: 'swiper-pagination-bullet-active',
          renderBullet: function (index, className) {
            return '<span class="' + className + '"></span>';
          },
        },
        on: {
          touchStart: function(swiper, event) {
            // Detener propagación al swiper principal
            if (event) {
              event.stopPropagation();
            }
          },
          touchMove: function(swiper, event) {
            // Detener propagación al swiper principal
            if (event) {
              event.stopPropagation();
            }
          },
          touchEnd: function(swiper, event) {
            // Detener propagación al swiper principal
            if (event) {
              event.stopPropagation();
            }
          },
        },
      });
      
      // Forzar actualización de paginación después de inicialización
      if (productSwiper.pagination) {
        productSwiper.pagination.render();
        productSwiper.pagination.update();
      }

      // Forzar object-fit: contain en todas las imágenes del swiper (sobrescribe estilos inline)
      const images = swiperEl.querySelectorAll('img');
      images.forEach((img) => {
        // Forzar contain para sobrescribir estilos inline (especialmente en Safari)
        img.style.setProperty('object-fit', 'contain', 'important');
        img.style.setProperty('-webkit-object-fit', 'contain', 'important');
        img.style.setProperty('object-position', 'center', 'important');
        img.style.setProperty('-webkit-object-position', 'center', 'important');
        img.style.setProperty('max-width', '100%', 'important');
        img.style.setProperty('max-height', '100%', 'important');
      });

      // También forzar cuando las imágenes se carguen
      images.forEach((img) => {
        if (img.complete) {
          img.style.setProperty('object-fit', 'contain', 'important');
          img.style.setProperty('-webkit-object-fit', 'contain', 'important');
        } else {
          img.addEventListener('load', function() {
            this.style.setProperty('object-fit', 'contain', 'important');
            this.style.setProperty('-webkit-object-fit', 'contain', 'important');
            this.style.setProperty('object-position', 'center', 'important');
            this.style.setProperty('-webkit-object-position', 'center', 'important');
          }, { once: true });
        }
      });

      // Prevenir propagación de eventos touch al swiper principal (método adicional)
      const wrapper = swiperEl.querySelector('.swiper-wrapper');
      let touchStartX = 0;
      let touchStartY = 0;
      let isHorizontalSwipe = false;
      
      // Encontrar el swiper principal (grid-slider) más cercano
      const findParentGridSlider = (element) => {
        let parent = element.closest('grid-slider');
        if (!parent) {
          parent = element.closest('[data-grid-slider-wrapper]')?.querySelector('grid-slider');
        }
        return parent;
      };
      
      const parentGridSlider = findParentGridSlider(swiperEl);
      
      if (wrapper) {
        wrapper.addEventListener('touchstart', (e) => {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          isHorizontalSwipe = false;
          
          // Desactivar temporalmente el swiper principal
          if (parentGridSlider && parentGridSlider.swiper) {
            parentGridSlider.swiper.allowTouchMove = false;
          }
          
          e.stopPropagation();
        }, { passive: true, capture: true });
        
        wrapper.addEventListener('touchmove', (e) => {
          if (!touchStartX || !touchStartY) return;
          
          const touchCurrentX = e.touches[0].clientX;
          const touchCurrentY = e.touches[0].clientY;
          const diffX = Math.abs(touchCurrentX - touchStartX);
          const diffY = Math.abs(touchCurrentY - touchStartY);
          
          // Determinar si es un swipe horizontal (más horizontal que vertical)
          if (diffX > diffY && diffX > 10) {
            isHorizontalSwipe = true;
            // Mantener desactivado el swiper principal durante swipe horizontal
            if (parentGridSlider && parentGridSlider.swiper) {
              parentGridSlider.swiper.allowTouchMove = false;
            }
          }
          
          e.stopPropagation();
        }, { passive: true, capture: true });
        
        wrapper.addEventListener('touchend', (e) => {
          // Reactivar el swiper principal después de un delay
          setTimeout(() => {
            if (parentGridSlider && parentGridSlider.swiper) {
              parentGridSlider.swiper.allowTouchMove = true;
            }
          }, 100);
          
          touchStartX = 0;
          touchStartY = 0;
          isHorizontalSwipe = false;
          e.stopPropagation();
        }, { passive: true, capture: true });
      }
      
      // También prevenir en el contenedor principal
      swiperEl.addEventListener('touchstart', (e) => {
        e.stopPropagation();
      }, { passive: true, capture: true });
      
      swiperEl.addEventListener('touchmove', (e) => {
        e.stopPropagation();
      }, { passive: true, capture: true });
      
      swiperEl.addEventListener('touchend', (e) => {
        e.stopPropagation();
      }, { passive: true, capture: true });
    }
  });
}

// Función para forzar object-fit: contain en todas las imágenes de productos
function forceContainOnProductImages() {
  const productImageContainers = document.querySelectorAll('.product-card-image-container, .grid-view-item-image-swiper');
  
  productImageContainers.forEach((container) => {
    const images = container.querySelectorAll('img');
    images.forEach((img) => {
      // Forzar contain para sobrescribir estilos inline (especialmente en Safari)
      img.style.setProperty('object-fit', 'contain', 'important');
      img.style.setProperty('-webkit-object-fit', 'contain', 'important');
      img.style.setProperty('object-position', 'center', 'important');
      img.style.setProperty('-webkit-object-position', 'center', 'important');
      img.style.setProperty('max-width', '100%', 'important');
      img.style.setProperty('max-height', '100%', 'important');
      
      // También forzar cuando la imagen se cargue
      if (img.complete) {
        img.style.setProperty('object-fit', 'contain', 'important');
        img.style.setProperty('-webkit-object-fit', 'contain', 'important');
      } else {
        img.addEventListener('load', function() {
          this.style.setProperty('object-fit', 'contain', 'important');
          this.style.setProperty('-webkit-object-fit', 'contain', 'important');
          this.style.setProperty('object-position', 'center', 'important');
          this.style.setProperty('-webkit-object-position', 'center', 'important');
        }, { once: true });
      }
    });
  });
}

// Inicializar al cargar la página
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function() {
    initProductSwipers();
    forceContainOnProductImages();
  });
} else {
  initProductSwipers();
  forceContainOnProductImages();
}

// Reinicializar después de cargas dinámicas
setTimeout(() => {
  initProductSwipers();
  forceContainOnProductImages();
}, 500);
