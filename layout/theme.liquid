  {% render 'globo.swatch.custom' %}

<script>
(function() {
  const HANDLE = "{{ product.handle | escape }}";
  let pj = null;

  async function getProductJSON() {
    if (pj) return pj;
    try {
      const res = await fetch(`/products/${HANDLE}.js`);
      pj = await res.json();
    } catch(e) { pj = null; }
    return pj;
  }

  function setUrlVariant(id) {
    try {
      const url = new URL(location.href);
      url.searchParams.set('variant', String(id));
      history.replaceState({}, '', url.toString());
    } catch(e) {}
  }

  function updateFormVariant(id) {
    const forms = document.querySelectorAll('form[action*="/cart/add"] input[name="id"]');
    forms.forEach(inp => {
      if (String(inp.value) !== String(id)) {
        inp.value = String(id);
        inp.dispatchEvent(new Event('change', {bubbles:true}));
        inp.dispatchEvent(new Event('input',  {bubbles:true}));
      }
    });
  }

  // --- Flow が拾いそうなイベントをまとめて発火 ---
  function broadcastVariant(variant) {
    const detail = { variant, id: variant?.id, product: pj };
    const evts = [
      'theme:variant:change',   // Flow系でよく使われる
      'variant:change',
      'variant:changed',
      'product:variant-change'
    ];
    evts.forEach(name => document.dispatchEvent(new CustomEvent(name, { detail })));

    // <product-media> が持つ data-selected-variant を同期（Flowがこれを監視してる場合あり）
    document.querySelectorAll('product-media, [data-selected-variant]').forEach(el => {
      try { el.setAttribute('data-selected-variant', JSON.stringify(variant)); } catch(e){}
    });
  }

  // ========== デスクトップ（grid）を強制切替 ==========
  function forceSwapDesktopGrid(imgUrl) {
    const gridMain = document.querySelector('product-media-grid [data-media-main]');
    if (!gridMain || !imgUrl) return false;

    // 1) まず一致する <img> を探してスクロール＆強調
    const base = imgUrl.split('?')[0];
    const match = gridMain.querySelector(`img[src*="${base}"], source[srcset*="${base}"]`);
    if (match) {
      const a = match.closest('a[data-main-media-link]');
      a?.scrollIntoView({block:'nearest', inline:'nearest'});
      // 視覚的に一番上に来るように先頭へ移動（副作用少）
      const col = a.closest('.media-column--odd, .media-column--even') || gridMain;
      col.insertBefore(a, col.firstElementChild);
      return true;
    }

    // 2) 見つからなければ先頭の画像を置換（最終手段）
    const firstA = gridMain.querySelector('a[data-main-media-link]');
    const firstImg = firstA?.querySelector('img');
    if (firstA && firstImg) {
      firstA.href = imgUrl + '&width=1445';
      firstImg.src = imgUrl + '&width=1445';
      firstImg.setAttribute('srcset', imgUrl + ' 1x');
      firstImg.loading = 'eager';
      return true;
    }
    return false;
  }

  // ========== モバイル（swiper）を強制切替 ==========
  function forceSwapMobileSwiper(mediaId, imgUrl) {
    const sliderMain = document.querySelector('product-media [data-slider-main].swiper');
    if (!sliderMain) return false;

    // 1) 対象のスライドがあればそれを「アクティブ化」
    if (mediaId) {
      const target = sliderMain.querySelector(`.swiper-slide[data-media-id="${mediaId}"]`);
      if (target) {
        const wrap = sliderMain.querySelector('.swiper-wrapper');
        // 先頭に移動すると視覚的に切り替わる（Swiper APIなしでもOK）
        wrap.insertBefore(target, wrap.firstElementChild);
        // activeクラス付け替え
        wrap.querySelectorAll('.swiper-slide').forEach((s,i)=>{
          s.classList.toggle('swiper-slide-active', i===0);
          s.classList.toggle('swiper-slide-next', i===1);
          s.style.pointerEvents = i===0 ? 'auto' : 'none';
        });
        return true;
      }
    }

    // 2) mediaIdが無い/見つからない → 現在の active の画像を直接差し替え
    if (imgUrl) {
      const activeImg = sliderMain.querySelector('.swiper-slide-active img');
      const activeLink = sliderMain.querySelector('.swiper-slide-active a[data-main-media-link]');
      if (activeImg) {
        activeImg.src = imgUrl + '&width=1445';
        activeImg.setAttribute('srcset', imgUrl + ' 1x');
        activeImg.loading = 'eager';
      }
      if (activeLink) activeLink.href = imgUrl + '&width=1445';
      return true;
    }
    return false;
  }

  async function switchGallery(variantId) {
    const data = await getProductJSON();
    const v = data?.variants?.find(x => String(x.id) === String(variantId));
    if (!v) return;

    const mediaId = v.featured_media?.id || v.featured_image?.id || null;
    const imgUrl  = (v.featured_media?.preview_image?.src || v.featured_image?.src || '').replace(/^https?:/,'');
    // 1) Flowに合図
    broadcastVariant(v);
    // 2) デスクトップ強制
    forceSwapDesktopGrid(imgUrl);
    // 3) モバイル強制
    forceSwapMobileSwiper(mediaId, imgUrl);
  }

  function extractVariantIdFromGlobo(target) {
    // GLO の li / input に data-variantid が入っている
    const li = target.closest('[data-variantid]');
    if (li?.dataset?.variantid) return li.dataset.variantid;

    // product-swatch（Flow純正）の data-swatch-variant-id
    const se = target.closest('[data-swatch-variant-id]');
    if (se?.dataset?.swatchVariantId) return se.dataset.swatchVariantId;

    // hidden input の id 候補
    const hidden = document.querySelector('form[action*="/cart/add"] input[name="id"]');
    if (hidden?.value) return hidden.value;

    // URL ?variant
    try { return new URL(location.href).searchParams.get('variant'); } catch(e){}
    return null;
  }

  function onAnyClickChange(e) {
    const vid = extractVariantIdFromGlobo(e.target);
    if (!vid) return;
    setUrlVariant(vid);
    updateFormVariant(vid);
    switchGallery(vid);
  }

  document.addEventListener('click', onAnyClickChange, true);
  document.addEventListener('change', onAnyClickChange, true);

  // 直接 ?variant=xxx で来た時も同期
  (function initFromUrl() {
    let vid = null;
    try { vid = new URL(location.href).searchParams.get('variant'); } catch(e){}
    if (!vid) return;
    updateFormVariant(vid);
    switchGallery(vid);
  })();
})();
</script>
</body>
