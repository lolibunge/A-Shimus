              <a aria-label="{{ 'general.accessibility.clear_all_filters' | t }}" href="{{ filter.url_to_remove }}" class="facets__reset link underlined-link price-filter-reset js-facet-remove" >{{ 'sections.collection_template.reset' | t }}</a>
            </div>
            <price-range-selector class="facets__price">
