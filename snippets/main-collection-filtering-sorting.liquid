            </div> {% endcomment %}

            {% liquid 
              if filter.presentation == 'swatch'
                assign filter_swatch_class = 'swatch-type-color'
              elsif filter.presentation == 'image'
                assign filter_swatch_class = 'swatch-type-image'
              endif
            %}

