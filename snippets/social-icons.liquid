{% comment %}
  Accepts the following options:
  - wrapper_classes: Add Additional classes to icons' ul wrapper
  - icon_wrapper_classes: Add additional classes to svg's wrapper
  - icon_classes: Additional classes to add to the icon
  - icon_width: The width of the icon
  - icon_height: The height of the icon
  - icon_fill: The fill color of the icon
{% endcomment %}

{% if
  settings.sm_facebook_link != blank or
  settings.sm_x_link != blank or
  settings.sm_youtube_link != blank or
  settings.sm_flickr_link != blank or
  settings.sm_pinterest_link != blank or
  settings.sm_instagram_link != blank or
  settings.sm_tumblr_link != blank or
  settings.sm_pinterest_link != blank or
  settings.sm_youtube_link != blank or
  settings.sm_vimeo_link != blank or
  settings.sm_flickr_link != blank or
  settings.sm_snapchat_link != blank or
  settings.sm_houzz_link != blank or
  settings.sm_linkedin_link != blank or
  settings.sm_tiktok_link != blank %}

<ul id="sm-icons" class="clearfix {{ wrapper_classes }}">


  {% if settings.sm_x_link != blank %}
    <li id="sm-x"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_x_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.x' | t }}">{% render 'theme-icon' with icon: 'x', iconClasses: icon_classes %}</a></li>
  {% endif %}


  {% if settings.sm_tumblr_link != blank %}
    <li id="sm-tumblr"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_tumblr_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.tumblr' | t }}">{% render 'theme-icon' with icon: 'tumblr', iconClasses: icon_classes %}</a></li>
  {% endif %}

  {% if settings.sm_pinterest_link != blank %}
    <li id="sm-pinterest"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_pinterest_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.pinterest' | t }}">{% render 'theme-icon' with icon: 'pinterest', iconClasses: icon_classes %}</a></li>
  {% endif %}


  
  {% if settings.sm_instagram_link != blank %}
    <li id="sm-instagram"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_instagram_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.instagram' | t }}">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"></rect>
        <circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="2"></circle>
        <circle cx="17.25" cy="6.75" r="1.25" fill="currentColor"></circle>
      </svg>
      </a></li>
  {% endif %}
  
  {% if settings.sm_linkedin_link != blank %}
    <li id="sm-linkedin"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_linkedin_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.linkedin' | t }}">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M5.52 8.5H9.1V20H5.52V8.5ZM7.31 3C8.46 3 9.4 3.94 9.4 5.09C9.4 6.25 8.46 7.18 7.31 7.18C6.15 7.18 5.22 6.25 5.22 5.09C5.22 3.94 6.15 3 7.31 3ZM11.36 8.5H14.79V10.07H14.84C15.31 9.17 16.46 8.21 18.18 8.21C21.75 8.21 22.4 10.56 22.4 13.62V20H18.82V14.34C18.82 12.99 18.8 11.26 16.95 11.26C15.08 11.26 14.79 12.72 14.79 14.25V20H11.36V8.5Z"></path>
      </svg>
      </a></li>
  {% endif %}

    
  {% if settings.sm_facebook_link != blank %}
    <li id="sm-facebook"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_facebook_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.facebook' | t }}">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M22.675 0H1.326C0.597 0 0 0.597 0 1.326V22.674C0 23.403 0.597 24 1.326 24H12.821V14.706H9.692V11.08H12.821V8.413C12.821 5.313 14.715 3.625 17.48 3.625C18.806 3.625 19.943 3.724 20.275 3.768V7.01L18.357 7.011C16.853 7.011 16.561 7.726 16.561 8.774V11.08H20.148L19.681 14.706H16.561V24H22.675C23.403 24 24 23.403 24 22.674V1.326C24 0.597 23.403 0 22.675 0Z"></path>
      </svg>
    </a></li>
  {% endif %}

  {% if settings.sm_youtube_link != blank %}
    <li id="sm-youtube"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_youtube_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.youtube' | t }}">
      <svg viewBox="0 0 24 24" width="28" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M23 9.7C23 8 22.86 6.73 22.52 5.94C22.29 5.39 21.86 4.96 21.31 4.73C20.52 4.39 19.26 4.25 17.55 4.25H6.45C4.74 4.25 3.48 4.39 2.69 4.73C2.14 4.96 1.71 5.39 1.48 5.94C1.14 6.73 1 8 1 9.7V14.3C1 16 1.14 17.27 1.48 18.06C1.71 18.61 2.14 19.04 2.69 19.27C3.48 19.61 4.74 19.75 6.45 19.75H17.55C19.26 19.75 20.52 19.61 21.31 19.27C21.86 19.04 22.29 18.61 22.52 18.06C22.86 17.27 23 16 23 14.3V9.7ZM10.2 15.5V8.5L16.25 12L10.2 15.5Z"></path>
      </svg>
      </a></li>
  {% endif %}

  {% if settings.sm_vimeo_link != blank %}
    <li id="sm-vimeo"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_vimeo_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.vimeo' | t }}">{% render 'theme-icon' with icon: 'vimeo', iconClasses: icon_classes %}</a></li>
  {% endif %}

  {% if settings.sm_flickr_link != blank %}
    <li id="sm-flickr"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_flickr_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.flickr' | t }}">{% render 'theme-icon' with icon: 'flickr', iconClasses: icon_classes %}</a></li>
  {% endif %}

  {% if settings.sm_snapchat_link != blank %}
    <li id="sm-snapchat"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_snapchat_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.snapchat' | t }}">{% render 'theme-icon' with icon: 'snapchat', iconClasses: icon_classes %}</a></li>
  {% endif %}

  {% if settings.sm_houzz_link != blank %}
    <li id="sm-houzz"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }}" href="{{ settings.sm_houzz_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.houzz' | t }}">{% render 'theme-icon' with icon: 'houzz', iconClasses: icon_classes %}</a></li>
  {% endif %}

  {% if settings.sm_tiktok_link != blank %}
    <li id="sm-tiktok"><a class="standalone-icon--wrapper {{ icon_wrapper_classes }} tiktok-wrapper" href="{{ settings.sm_tiktok_link }}" target="_blank" aria-label="{{ 'general.accessibility.social_media.tiktok' | t }}">{% render 'theme-icon' with icon: 'tiktok', iconClasses: icon_classes %}</a></li>
  {% endif %}

</ul>

{% endif %}
