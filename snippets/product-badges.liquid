{% comment %}
  Automatic Product Badges Snippet for Shopify
  Usage: {% render 'product-badges', product: product, collection: collection %}
  
  Parameters:
  - product: Required - The product object
  - collection: Optional - The collection object for best seller calculation
  - show_low_stock: Optional - Show low stock badge (default: true)
  - show_best_seller: Optional - Show best seller badge (default: true)
  - show_tag_badges: Optional - Show tag-based badges (default: true)
  - badge_position: Optional - CSS classes for positioning (default: 'absolute top-4 left-4 z-10')
  
  Best Seller Methods (best_seller_method):
  - 'strict': Only products with 'best-seller' tag (default)
  - 'sales': Based on sales count metafield
  - 'collection': Top X products in best-selling sorted collection
  - 'reviews': Based on review count and rating
  - 'combined': Multiple criteria must be met
  - 'manual': Only manual metafield
  
  Additional Best Seller Parameters:
  - best_seller_top_count: Number of top products (default: 5, for 'collection' method)
  - min_sales_for_bestseller: Minimum sales required (default: 100, for 'sales' method)
  - min_reviews_for_bestseller: Minimum reviews required (default: 50, for 'reviews' method)
  - min_rating_for_bestseller: Minimum rating required (default: 4.5, for 'reviews' method)
{% endcomment %}

{% assign show_low_stock = show_low_stock | default: true %}
{% assign show_best_seller = show_best_seller | default: true %}
{% assign show_tag_badges = show_tag_badges | default: true %}
{% assign badge_position = badge_position | default: 'absolute top-4 left-4 z-10' %}

<div class="product-badges {{ badge_position }}">
  <div class="badges-container flex flex-col gap-2">
    
    {% comment %} Low Stock Badge - Shows when inventory is between 1-5 {% endcomment %}
    {% if show_low_stock %}
      {% assign total_inventory = 0 %}
      {% for variant in product.variants %}
        {% if variant.inventory_management %}
          {% assign total_inventory = total_inventory | plus: variant.inventory_quantity %}
        {% endif %}
      {% endfor %}
      
      {% if total_inventory > 0 and total_inventory <= 5 %}
        <span class="badge badge-low-stock bg-red-500 text-white px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg animate-pulse">
         {% comment %} Only {{ total_inventory }} Left! {% endcomment %} Only a Few Left
        </span>
      {% endif %}
    {% endif %}
    
    {% comment %} Best Seller Badge - More restrictive logic with multiple methods {% endcomment %}
    {% if show_best_seller %}
      {% assign is_best_seller = false %}
      {% assign best_seller_method = best_seller_method | default: 'strict' %}
      
      {% comment %} STRICT MODE: Only explicit best sellers {% endcomment %}
      {% if best_seller_method == 'strict' %}
        {% comment %} Only check for explicit best-seller tag {% endcomment %}
        {% if product.tags contains 'best-seller' %}
          {% assign is_best_seller = true %}
        {% endif %}
        
      {% comment %} SALES MODE: Based on sales count (requires metafield) {% endcomment %}
      {% elsif best_seller_method == 'sales' %}
        {% comment %} Check if product has high sales count in metafield {% endcomment %}
        {% assign min_sales = min_sales_for_bestseller | default: 100 %}
        {% if product.metafields.custom.total_sales %}
          {% assign product_sales = product.metafields.custom.total_sales | plus: 0 %}
          {% if product_sales >= min_sales %}
            {% assign is_best_seller = true %}
          {% endif %}
        {% endif %}
        
      {% comment %} COLLECTION MODE: Top products in best-selling collection {% endcomment %}
      {% elsif best_seller_method == 'collection' %}
        {% assign top_products_count = best_seller_top_count | default: 5 %}
        {% if collection and collection.products.size > 0 %}
          {% comment %} Only if collection is sorted by best-selling {% endcomment %}
          {% if collection.sort_by == 'best-selling' or collection.default_sort_by == 'best-selling' %}
            {% for collection_product in collection.products limit: top_products_count %}
              {% if collection_product.id == product.id %}
                {% assign is_best_seller = true %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endif %}
        
      {% comment %} REVIEWS MODE: Based on review count and rating {% endcomment %}
      {% elsif best_seller_method == 'reviews' %}
        {% comment %} Requires review app metafields {% endcomment %}
        {% assign min_reviews = min_reviews_for_bestseller | default: 50 %}
        {% assign min_rating = min_rating_for_bestseller | default: 4.5 %}
        {% if product.metafields.reviews.rating and product.metafields.reviews.rating_count %}
          {% assign review_count = product.metafields.reviews.rating_count | plus: 0 %}
          {% assign review_rating = product.metafields.reviews.rating | plus: 0.0 %}
          {% if review_count >= min_reviews and review_rating >= min_rating %}
            {% assign is_best_seller = true %}
          {% endif %}
        {% endif %}
        
      {% comment %} AUTOMATIC MODE: Based on inventory and sales signals {% endcomment %}
      {% elsif best_seller_method == 'automatic' %}
        {% assign automatic_score = 0 %}
        
        {% comment %} Check 1: Low inventory velocity (fast selling) {% endcomment %}
        {% assign total_inventory = 0 %}
        {% for variant in product.variants %}
          {% if variant.inventory_management %}
            {% assign total_inventory = total_inventory | plus: variant.inventory_quantity %}
          {% endif %}
        {% endfor %}
        
        {% assign days_old = 'now' | date: '%s' | minus: product.created_at | date: '%s' | divided_by: 86400 %}
        
        {% if total_inventory > 0 and total_inventory <= 15 and days_old > 30 %}
          {% unless product.tags contains 'new' %}
            {% assign automatic_score = automatic_score | plus: 3 %}
          {% endunless %}
        {% elsif total_inventory > 15 and total_inventory <= 30 and days_old > 30 %}
          {% assign automatic_score = automatic_score | plus: 1 %}
        {% endif %}
        
        {% comment %} Check 2: Multiple variants sold out {% endcomment %}
        {% assign variants_count = product.variants | size %}
        {% assign soldout_variants = 0 %}
        {% for variant in product.variants %}
          {% unless variant.available %}
            {% assign soldout_variants = soldout_variants | plus: 1 %}
          {% endunless %}
        {% endfor %}
        
        {% if variants_count > 2 and soldout_variants > 0 %}
          {% assign soldout_percentage = soldout_variants | times: 100 | divided_by: variants_count %}
          {% if soldout_percentage >= 50 %}
            {% assign automatic_score = automatic_score | plus: 2 %}
          {% elsif soldout_percentage >= 25 %}
            {% assign automatic_score = automatic_score | plus: 1 %}
          {% endif %}
        {% endif %}
        
        {% comment %} Check 3: In multiple collections {% endcomment %}
        {% assign collection_count = product.collections | size %}
        {% if collection_count >= 5 %}
          {% assign automatic_score = automatic_score | plus: 1 %}
        {% endif %}
        
        {% comment %} Check 4: Featured collection membership {% endcomment %}
        {% for c in product.collections %}
          {% assign handle_lower = c.handle | downcase %}
          {% if handle_lower contains 'best' or handle_lower contains 'trending' or handle_lower contains 'popular' or handle_lower contains 'featured' %}
            {% assign automatic_score = automatic_score | plus: 2 %}
            {% break %}
          {% endif %}
        {% endfor %}
        
        {% comment %} Check 5: Restocked product {% endcomment %}
        {% if product.tags contains 'restocked' or product.tags contains 'back-in-stock' %}
          {% if total_inventory < 50 %}
            {% assign automatic_score = automatic_score | plus: 2 %}
          {% endif %}
        {% endif %}
        
        {% comment %} Check 6: Price indicates popularity (not clearance, not luxury) {% endcomment %}
        {% if product.compare_at_price > product.price %}
          {% assign discount_percentage = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
          {% if discount_percentage < 30 and total_inventory < 40 %}
            {% assign automatic_score = automatic_score | plus: 1 %}
          {% endif %}
        {% endif %}
        
        {% comment %} Minimum score of 4 to show badge {% endcomment %}
        {% assign min_score = min_score_for_automatic | default: 4 %}
        {% if automatic_score >= min_score %}
          {% assign is_best_seller = true %}
        {% endif %}
        
      {% comment %} COMBINED MODE: Multiple criteria must be met {% endcomment %}
      {% elsif best_seller_method == 'combined' %}
        {% assign criteria_met = 0 %}
        {% assign criteria_needed = 2 %}
        
        {% comment %} Check tag {% endcomment %}
        {% if product.tags contains 'best-seller' %}
          {% assign criteria_met = criteria_met | plus: 1 %}
        {% endif %}
        
        {% comment %} Check if in top 3 of collection {% endcomment %}
        {% if collection and collection.sort_by == 'best-selling' %}
          {% for collection_product in collection.products limit: 3 %}
            {% if collection_product.id == product.id %}
              {% assign criteria_met = criteria_met | plus: 1 %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}
        
        {% comment %} Check inventory velocity (high sales + low stock = hot item) {% endcomment %}
        {% assign total_inventory = 0 %}
        {% for variant in product.variants %}
          {% if variant.inventory_management %}
            {% assign total_inventory = total_inventory | plus: variant.inventory_quantity %}
          {% endif %}
        {% endfor %}
        {% if total_inventory > 0 and total_inventory <= 20 and product.tags contains 'restock-frequent' %}
          {% assign criteria_met = criteria_met | plus: 1 %}
        {% endif %}
        
        {% comment %} Check creation date (not a best seller if too new) {% endcomment %}
        {% assign days_since_created = 'now' | date: '%s' | minus: product.created_at | date: '%s' | divided_by: 86400 %}
        {% if days_since_created > 30 %}
          {% assign criteria_met = criteria_met | plus: 1 %}
        {% endif %}
        
        {% if criteria_met >= criteria_needed %}
          {% assign is_best_seller = true %}
        {% endif %}
        
      {% comment %} MANUAL MODE: Only metafield {% endcomment %}
      {% elsif best_seller_method == 'manual' %}
        {% if product.metafields.custom.is_best_seller == true %}
          {% assign is_best_seller = true %}
        {% endif %}
      {% endif %}
      
      {% if is_best_seller %}
        <span class="badge badge-best-seller bg-gold-500 text-black px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg" style="background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);">
          <svg class="inline-block w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          Best Seller
        </span>
      {% endif %}
    {% endif %}
    
    {% comment %} Tag-based Badges - Displays badges based on product tags {% endcomment %}
    {% if show_tag_badges %}
      {% for tag in product.tags %}
        {% assign tag_lower = tag | downcase %}
        
        {% comment %} New Arrival Badge 
        {% if tag_lower == 'new' or tag_lower == 'new-arrival' or tag_lower == 'just-arrived' %}
          <span class="badge badge-new bg-green-500 text-white px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg">
            New Arrival
          </span>
        {% endif %}{% endcomment %}
        
        {% comment %} Sale Badge 
        {% if tag_lower == 'sale' or tag_lower == 'on-sale' %}
          <span class="badge badge-sale bg-red-600 text-white px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg">
            Sale
          </span>
        {% endif %}{% endcomment %}
        
        {% comment %} Limited Edition Badge 
        {% if tag_lower == 'limited-edition' or tag_lower == 'limited' %}
          <span class="badge badge-limited bg-purple-600 text-white px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg">
            Limited Edition
          </span>
        {% endif %}{% endcomment %}
        
        {% comment %} Exclusive Badge 
        {% if tag_lower == 'exclusive' or tag_lower == 'online-exclusive' %}
          <span class="badge badge-exclusive bg-black text-white px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg">
            Exclusive
          </span>
        {% endif %}{% endcomment %}
        
        {% comment %} Eco-Friendly Badge
        {% if tag_lower == 'eco-friendly' or tag_lower == 'sustainable' or tag_lower == 'eco' %}
          <span class="badge badge-eco bg-green-600 text-white px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg">
            <svg class="inline-block w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 3.636a1 1 0 010 1.414L3.636 6.464a1 1 0 11-1.414-1.414l1.414-1.414a1 1 0 011.414 0zM16.95 16.364a1 1 0 010-1.414l1.414-1.414a1 1 0 111.414 1.414l-1.414 1.414a1 1 0 01-1.414 0zM10 11a1 1 0 100-2 1 1 0 000 2zm0 5a5 5 0 100-10 5 5 0 000 10z" clip-rule="evenodd"/>
            </svg>
            Eco-Friendly
          </span>
        {% endif %}{% endcomment %}
        
        {% comment %} Custom tag badges with tag_ prefix {% endcomment %}
        {% if tag contains 'tag_' %}
          {% assign badge_text = tag | remove: 'tag_' | replace: '-', ' ' | replace: '_', ' ' | capitalize %}
          <span class="badge badge-custom bg-blue-500 text-white px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg">
            {{ badge_text }}
          </span>
        {% endif %}
      {% endfor %}
    {% endif %}
    
    {% comment %} Discount Percentage Badge (if product is on sale) 
    {% if product.compare_at_price > product.price %}
      {% assign discount = product.compare_at_price | minus: product.price %}
      {% assign discount_percentage = discount | times: 100 | divided_by: product.compare_at_price | round %}
      {% if discount_percentage > 0 %}
        <span class="badge badge-discount bg-red-500 text-white px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide shadow-lg">
          {{ discount_percentage }}% OFF
        </span>
      {% endif %}
    {% endif %}{% endcomment %}
    
  </div>
</div>

<style>
  .badges-container{
    gap: 5px;
  }
  .product-badges {
    pointer-events: none;
    margin-top: 7px;
  }
  
  .product-badges .badge {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition: transform 0.2s ease;
    font-size: 12px;
    background: #fff;
  padding: 5px;
  }
  /*
  .product-badges .badge:hover {
    transform: scale(1.05);
  }*/
  
  /* Animation for low stock badge */
  /*@keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.8;
    }
  }*/
  
  /*.animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }*/
  
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .product-badges {
      top: 0.5rem;
      left: 0.5rem;
    }
    
    .product-badges .badge {
      font-size: 0.625rem;
      padding: 0.25rem 0.5rem;
    }
  }
</style>
