{% comment %}
  As Featured In – Logo Carousel (Swiper.js)
{% endcomment %}

<style>
  .featured-in-section {
    position: relative;
  }

  .featured-in {
    padding: 72px 0;
    background: #fff;
  }

  .featured-in .featured-in__title {
    color: #000;
    font-family: var(--body-font-stack);
    font-weight: 500;
    font-size: 32px;
    line-height: normal;
    letter-spacing: 0;
    text-align: center;
    margin-bottom: 10px;
  }

  .featured-in__swiper {
    width: 100%;
    padding: 40px 0;
  }

  .featured-in__swiper-mobile {
    display: none;
  }

  .featured-in__swiper-row {
    width: 100%;
    overflow: visible;
  }

  .featured-in__swiper-row-2 {
    margin-top: 24px;
    transform: translateX(10px);
  }

  .featured-in__slide {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: fit-content;
    max-width: fit-content;
  }

  .featured-in__slide img {
    height: 50px;
    width: auto;
    object-fit: contain;
  }

  .featured-in__divider {
    position: absolute;
    top: 0;
    left: 48px;
    width: calc(100% - 96px);
    height: 1px;
    margin: 0;
  }

  @media (max-width: 768px) {
    .featured-in__divider {
    left: 24px;
    width: calc(100% - 48px);
  }
    .featured-in__swiper {
      display: none;
    }

    .featured-in__swiper-mobile {
      display: block;
      padding: 32px 0 0 0;
    }

    .featured-in__swiper-row {
      padding: 0;
      overflow: hidden;
      touch-action: pan-y;
    }

    .featured-in__swiper-row .swiper-wrapper {
      display: flex !important;
      will-change: transform;
      width: fit-content !important;
    }

    .featured-in__swiper-row-1 .swiper-wrapper {
      animation: slideRow1 20s linear infinite !important;
    }

    .featured-in__swiper-row-2 .swiper-wrapper {
      animation: slideRow2 25s linear infinite !important;
    }

    @keyframes slideRow1 {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-33.333333%);
      }
    }

    @keyframes slideRow2 {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-33.333333%);
      }
    }

    .featured-in__swiper-row-2 {
      margin-top: 24px;
      transform: translateX(10px);
    }

    .featured-in__slide {
      display: flex;
      align-items: center;
      justify-content: center;
      height: auto;
      padding: 0;
      flex-shrink: 0;
      touch-action: pan-y;
      pointer-events: auto;
    }

    .featured-in__slide img {
      height: 30px;
    }

    .featured-in {
      padding: 60px 0;
      overflow: hidden;
    }

    .featured-in .featured-in__title {
      font-size: 24px;
    }
  }
</style>

<section id="featured-in-{{ section.id }}" class="featured-in">
  <hr class="featured-in__divider">
  {% if section.settings.title != blank %}
    <div class="featured-in__title">
      {{ section.settings.title }}
    </div>
  {% endif %}

  {% assign logo_count = 0 %}
  {% for block in section.blocks %}
    {% if block.settings.logo != blank %}
      {% assign logo_count = logo_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  <div class="swiper featured-in__swiper" data-logo-count="{{ logo_count }}">
    <div class="swiper-wrapper">
      {% for i in (1..3) %}
        {% assign block_counter = 0 %}
        {% for block in section.blocks %}
          {% if block.settings.logo != blank %}
            {% assign block_counter = block_counter | plus: 1 %}
            <div
              class="swiper-slide featured-in__slide"
              data-original-index="{{ block_counter }}"
              {% if i == 1 %}
                {{- block.shopify_attributes -}}
              {% endif %}
            >
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" target="_blank" rel="noopener">
                  <img
                    src="{{ block.settings.logo | image_url: height: 80 }}"
                    alt="{{ block.settings.alt | escape }}"
                    loading="lazy"
                  >
                </a>
              {% else %}
                <img
                  src="{{ block.settings.logo | image_url: height: 80 }}"
                  alt="{{ block.settings.alt | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <div class="featured-in__swiper-mobile">
    <div class="swiper featured-in__swiper-row featured-in__swiper-row-1">
      <div class="swiper-wrapper">
        {% for i in (1..3) %}
          {% assign block_counter = 0 %}
          {% for block in section.blocks %}
            {% if block.settings.logo != blank %}
              {% assign block_counter = block_counter | plus: 1 %}
              {% assign is_odd = block_counter | modulo: 2 %}
              {% if is_odd == 1 %}
                <div
                  class="swiper-slide featured-in__slide"
                  data-original-index="{{ block_counter }}"
                  {% if i == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" target="_blank" rel="noopener">
                      <img
                        src="{{ block.settings.logo | image_url: height: 80 }}"
                        alt="{{ block.settings.alt | escape }}"
                        loading="lazy"
                      >
                    </a>
                  {% else %}
                    <img
                      src="{{ block.settings.logo | image_url: height: 80 }}"
                      alt="{{ block.settings.alt | escape }}"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>

    <div class="swiper featured-in__swiper-row featured-in__swiper-row-2">
      <div class="swiper-wrapper">
        {% for i in (1..3) %}
          {% assign block_counter = 0 %}
          {% for block in section.blocks %}
            {% if block.settings.logo != blank %}
              {% assign block_counter = block_counter | plus: 1 %}
              {% assign is_even = block_counter | modulo: 2 %}
              {% if is_even == 0 %}
                <div
                  class="swiper-slide featured-in__slide"
                  data-original-index="{{ block_counter }}"
                >
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" target="_blank" rel="noopener">
                      <img
                        src="{{ block.settings.logo | image_url: height: 80 }}"
                        alt="{{ block.settings.alt | escape }}"
                        loading="lazy"
                      >
                    </a>
                  {% else %}
                    <img
                      src="{{ block.settings.logo | image_url: height: 80 }}"
                      alt="{{ block.settings.alt | escape }}"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const root = document.getElementById('featured-in-{{ section.id }}');
    if (!root) return;

    const MOBILE_BREAKPOINT = 768;
    const state = {
      desktopSwiper: null,
      mobileSwiperRow1: null,
      mobileSwiperRow2: null,
      resizeTimeout: null,
      hoverHandlersBound: false,
    };

    function isMobileView() {
      return window.innerWidth <= MOBILE_BREAKPOINT;
    }

    function destroyInstance(instance) {
      if (!instance || typeof instance.destroy !== 'function') return;
      instance.destroy(true, true);
    }

    function clearMobileAnimations() {
      const wrappers = root.querySelectorAll('.featured-in__swiper-mobile .swiper-wrapper');
      wrappers.forEach((wrapper) => {
        wrapper.style.animation = '';
      });
    }

    function initDesktopSwiper() {
      const swiperEl = root.querySelector('.featured-in__swiper');
      if (!swiperEl || state.desktopSwiper || isMobileView()) return;
      if (typeof window.Swiper !== 'function') return;

      const logoCount = parseInt(swiperEl.dataset.logoCount || '0', 10);
      if (!logoCount) return;

      const loopedSlides = Math.min(logoCount, 6);
      state.desktopSwiper = new window.Swiper(swiperEl, {
        loop: true,
        loopedSlides,
        speed: 1600,
        autoplay: {
          delay: 10,
          disableOnInteraction: false,
          pauseOnMouseEnter: false,
        },
        slidesPerView: 3,
        spaceBetween: 60,
        watchSlidesProgress: true,
        allowSlidePrev: true,
        allowSlideNext: true,
        breakpoints: {
          768: {
            slidesPerView: 4,
            loopedSlides: Math.min(logoCount, 4),
            spaceBetween: 80,
          },
          1024: {
            slidesPerView: 5,
            loopedSlides: Math.min(logoCount, 5),
            spaceBetween: 80,
          },
          1400: {
            slidesPerView: 6,
            loopedSlides: Math.min(logoCount, 6),
            spaceBetween: 80,
          },
          1600: {
            slidesPerView: 6.5,
            loopedSlides: Math.min(logoCount, 6),
            spaceBetween: 80,
          },
        },
      });

      if (state.desktopSwiper.autoplay && state.desktopSwiper.autoplay.running === false) {
        state.desktopSwiper.autoplay.start();
      }

      if (!state.hoverHandlersBound) {
        const pauseAutoplay = function () {
          if (state.desktopSwiper && state.desktopSwiper.autoplay && state.desktopSwiper.autoplay.running) {
            state.desktopSwiper.autoplay.pause();
          }
        };

        const resumeAutoplay = function () {
          if (state.desktopSwiper && state.desktopSwiper.autoplay) {
            state.desktopSwiper.autoplay.resume();
          }
        };

        swiperEl.addEventListener('mouseenter', pauseAutoplay);
        swiperEl.addEventListener('mouseleave', resumeAutoplay);
        state.hoverHandlersBound = true;
      }
    }

    function initMobileSwipers() {
      const swiperRow1El = root.querySelector('.featured-in__swiper-row-1');
      const swiperRow2El = root.querySelector('.featured-in__swiper-row-2');
      if (!swiperRow1El || !swiperRow2El || !isMobileView()) return;
      if (state.mobileSwiperRow1 || state.mobileSwiperRow2) return;
      if (typeof window.Swiper !== 'function') return;

      state.mobileSwiperRow1 = new window.Swiper(swiperRow1El, {
        loop: false,
        rewind: false,
        speed: 0,
        autoplay: false,
        allowTouchMove: false,
        slidesPerView: 2,
        spaceBetween: 60,
      });

      state.mobileSwiperRow2 = new window.Swiper(swiperRow2El, {
        loop: false,
        rewind: false,
        speed: 0,
        autoplay: false,
        allowTouchMove: false,
        slidesPerView: 1.8,
        spaceBetween: 60,
      });

      const wrapper1 = swiperRow1El.querySelector('.swiper-wrapper');
      const wrapper2 = swiperRow2El.querySelector('.swiper-wrapper');

      if (wrapper1) wrapper1.style.animation = 'slideRow1 20s linear infinite';
      if (wrapper2) wrapper2.style.animation = 'slideRow2 25s linear infinite';
    }

    function destroyDesktopSwiper() {
      destroyInstance(state.desktopSwiper);
      state.desktopSwiper = null;
    }

    function destroyMobileSwipers() {
      destroyInstance(state.mobileSwiperRow1);
      destroyInstance(state.mobileSwiperRow2);
      state.mobileSwiperRow1 = null;
      state.mobileSwiperRow2 = null;
      clearMobileAnimations();
    }

    function syncByViewport() {
      if (isMobileView()) {
        destroyDesktopSwiper();
        initMobileSwipers();
      } else {
        destroyMobileSwipers();
        initDesktopSwiper();
      }
    }

    function initWhenSwiperReady(retryCount) {
      if (typeof window.Swiper !== 'function') {
        if (retryCount < 40) {
          setTimeout(function () {
            initWhenSwiperReady(retryCount + 1);
          }, 100);
        }
        return;
      }
      syncByViewport();
    }

    function teardown() {
      clearTimeout(state.resizeTimeout);
      destroyDesktopSwiper();
      destroyMobileSwipers();
    }

    initWhenSwiperReady(0);

    window.addEventListener('resize', function () {
      clearTimeout(state.resizeTimeout);
      state.resizeTimeout = setTimeout(syncByViewport, 250);
    });

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (event) {
        if (event && event.detail && event.detail.sectionId === '{{ section.id }}') {
          initWhenSwiperReady(0);
        }
      });

      document.addEventListener('shopify:section:unload', function (event) {
        if (event && event.detail && event.detail.sectionId === '{{ section.id }}') {
          teardown();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "As Featured In",
  "class": "featured-in-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "As Featured In"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Featured logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "As Featured In",
      "category": "Media"
    }
  ]
}
{% endschema %}
