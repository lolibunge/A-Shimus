<script>
  (function() {
    // Move sorting components to bar-control-collection
    function moveSortingToBar() {
      const collectionFilteringForm = document.querySelector('collection-filtering-form');
      if (!collectionFilteringForm) return;
      
      // Move desktop sorting
      const sortingBarDesktop = document.querySelector('.sorting--desktop-bar');
      const sortingContainerDesktop = document.getElementById('sorting-container-desktop-bar');
      
      if (sortingBarDesktop && sortingContainerDesktop && !sortingContainerDesktop.contains(sortingBarDesktop)) {
        sortingBarDesktop.style.display = '';
        sortingContainerDesktop.appendChild(sortingBarDesktop);
        
        // Update the select ID to match the original for JavaScript compatibility
        const selectDesktop = sortingBarDesktop.querySelector('select');
        if (selectDesktop && selectDesktop.id === 'SortBydesktop-bar') {
          selectDesktop.id = 'SortBydesktop';
          // Remove name attribute to prevent it from being included in form submission
          // The hidden input sort_by_input will handle the actual form submission
          selectDesktop.removeAttribute('name');
          selectDesktop.setAttribute('form', 'CollectionFiltersForm');
        }
        
        // Hide the original desktop sort select inside the form and change its ID to avoid conflicts
        const originalSortingDesktop = collectionFilteringForm.querySelector('.facets__form-inner.desktop .collection-filters__item.sorting');
        if (originalSortingDesktop) {
          originalSortingDesktop.style.display = 'none';
          // Change the ID of the original select to avoid ID conflicts
          const originalSelectDesktop = originalSortingDesktop.querySelector('#SortBydesktop');
          if (originalSelectDesktop && originalSelectDesktop.id === 'SortBydesktop') {
            originalSelectDesktop.id = 'SortBydesktop-original';
          }
        }
      }
      
      // Move mobile sorting
      const sortingBarMobile = document.querySelector('.sorting--mobile-bar');
      const sortingContainerMobile = document.getElementById('sorting-container-mobile-bar');
      
      if (sortingBarMobile && sortingContainerMobile && !sortingContainerMobile.contains(sortingBarMobile)) {
        sortingBarMobile.style.display = '';
        sortingContainerMobile.appendChild(sortingBarMobile);
        
        // Update the select ID to match the original for JavaScript compatibility
        const selectMobile = sortingBarMobile.querySelector('select');
        if (selectMobile && selectMobile.id === 'SortBymobile-bar') {
          selectMobile.id = 'SortBymobile';
          // Remove name attribute to prevent it from being included in form submission
          // The hidden input sort_by_input will handle the actual form submission
          selectMobile.removeAttribute('name');
          selectMobile.setAttribute('form', 'CollectionFiltersForm');
        }
        
        // Hide the original mobile sort select inside the form and change its ID to avoid conflicts
        const originalSortingMobile = collectionFilteringForm.querySelector('.facets__form-inner.mobile .collection-filters__item.sorting');
        if (originalSortingMobile) {
          originalSortingMobile.style.display = 'none';
          // Change the ID of the original select to avoid ID conflicts
          const originalSelectMobile = originalSortingMobile.querySelector('#SortBymobile');
          if (originalSelectMobile && originalSelectMobile.id === 'SortBymobile') {
            originalSelectMobile.id = 'SortBymobile-original';
          }
        }
      }
      
      // Re-bind event listeners to include the moved selects
      // The custom element instance has the bindSortByEventListeners method
      if (collectionFilteringForm.bindSortByEventListeners) {
        collectionFilteringForm.bindSortByEventListeners();
      }
    }
    
    // Try to move sorting immediately and also after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(moveSortingToBar, 200);
      });
    } else {
      setTimeout(moveSortingToBar, 200);
    }
    
    // Also try after a longer delay to ensure collection-filtering-form is fully initialized
    setTimeout(moveSortingToBar, 500);
    
    const toggleButton = document.querySelector('#toggle-filter .toggle-filtering-btn');
    const collectionGrid = document.querySelector('.collection_grid.filtering_enabled--sidebar');
    const filterArea = document.querySelector('.grid-area--filtering');
    const buttonLabel = toggleButton?.querySelector('span');
    const gridClassesInput = document.getElementById('grid_item_width_classes');
    const gridItems = document.querySelectorAll('.collection-main-body .grid__item');

    if (!toggleButton || !collectionGrid || !filterArea || !buttonLabel) return;

    const originalGridClasses = gridClassesInput ? gridClassesInput.value : '';

    // Map desktop width classes to one fewer item per row
    function getReducedDesktopClasses(classString) {
      if (!classString) return classString;
      const mapping = {
        'large--one-half': 'large--one-whole',
        'large--one-third': 'large--one-half',
        'large--one-quarter': 'large--one-third',
        'large--one-fifth': 'large--one-quarter',
        'large--one-sixth': 'large--one-fifth'
      };

      return classString
        .split(' ')
        .map(cls => mapping[cls] || cls)
        .join(' ');
    }

    const reducedGridClasses = getReducedDesktopClasses(originalGridClasses);

    const LARGE_DESKTOP_CLASSES = [
      'large--one-whole',
      'large--one-half',
      'large--one-third',
      'large--one-quarter',
      'large--one-fifth',
      'large--one-sixth'
    ];

    const MEDIUM_TABLET_CLASSES = [
      'medium--one-whole',
      'medium--one-half',
      'medium--one-third',
      'medium--one-quarter',
      'medium--one-fifth',
      'medium--one-sixth'
    ];

    function applyGridDesktopClasses(classString) {
      if (!classString || !gridItems.length) return;
      const classList = classString.split(' ').filter(Boolean);

      gridItems.forEach(item => {
        item.classList.remove(...LARGE_DESKTOP_CLASSES);
        classList.forEach(cls => {
          if (cls.startsWith('large--')) {
            item.classList.add(cls);
          }
        });
      });
    }

    // Map tablet width classes to one fewer item per row
    function getReducedTabletClass(tabletClass) {
      if (!tabletClass) return tabletClass;
      const mapping = {
        'medium--one-whole': 'medium--one-whole', // Already at minimum
        'medium--one-half': 'medium--one-whole',
        'medium--one-third': 'medium--one-half',
        'medium--one-quarter': 'medium--one-third',
        'medium--one-fifth': 'medium--one-quarter',
        'medium--one-sixth': 'medium--one-fifth'
      };

      return mapping[tabletClass] || tabletClass;
    }

    function applyGridTabletClasses(classString, isVisible) {
      if (!classString || !gridItems.length) return;
      const classList = classString.split(' ').filter(Boolean);
      const tabletClass = classList.find(cls => cls.startsWith('medium--'));

      if (!tabletClass) return;

      const currentTabletProductsPerRow = parseInt('{{ section.settings.tablet-products-per-row }}') || 2;

      gridItems.forEach(item => {
        item.classList.remove(...MEDIUM_TABLET_CLASSES);
        if (isVisible) {
          // Filters visible: use reduced tablet columns (one less)
          const reducedTabletClass = getReducedTabletClass(tabletClass);
          if (reducedTabletClass && reducedTabletClass.startsWith('medium--')) {
            item.classList.add(reducedTabletClass);
          }
        } else {
          // Filters hidden: use original tablet columns
          item.classList.add(tabletClass);
        }
      });
    }

    // Function to update the label based on visibility state
    function updateButtonLabel(isVisible) {
      buttonLabel.textContent = isVisible ? 'Hidden filters' : 'Show filters';
    }

    // Function to check if filters are visible
    function isFiltersVisible() {
      return !collectionGrid.classList.contains('filters-hidden');
    }

    // Function to update promotional cards grid columns attribute
    function updatePromotionalCardsGridColumns(effectiveColumns) {
      const promotionalCards = document.querySelectorAll('.promotional-card');
      promotionalCards.forEach(card => {
        card.setAttribute('data-promotional-card-grid-columns', effectiveColumns);
      });
    }

    // Initialize grid classes based on initial visibility
    function syncGridClassesWithState(isVisible) {
      if (!gridClassesInput || !gridItems.length || !originalGridClasses) return;

      const currentDesktopProductsPerRow = parseInt('{{ section.settings.desktop-products-per-row }}');
      let effectiveColumns = currentDesktopProductsPerRow;

      if (isVisible) {
        // Filters visible: use reduced desktop columns (one less)
        effectiveColumns = currentDesktopProductsPerRow - 1;
        gridClassesInput.value = reducedGridClasses;
        applyGridDesktopClasses(reducedGridClasses);
        applyGridTabletClasses(originalGridClasses, true);
      } else {
        // Filters hidden: use original desktop columns
        effectiveColumns = currentDesktopProductsPerRow;
        gridClassesInput.value = originalGridClasses;
        applyGridDesktopClasses(originalGridClasses);
        applyGridTabletClasses(originalGridClasses, false);
      }
      
      // Update promotional cards grid columns attribute
      updatePromotionalCardsGridColumns(effectiveColumns);
    }

    // Set filters hidden by default
    collectionGrid.classList.add('filters-hidden');
    
    // Check initial state
    const isInitiallyVisible = isFiltersVisible();
    updateButtonLabel(isInitiallyVisible);
    syncGridClassesWithState(isInitiallyVisible);

    // Add event listener to button
    toggleButton.addEventListener('click', function() {
      const isCurrentlyVisible = isFiltersVisible();

      if (isCurrentlyVisible) {
        // Hide filters
        collectionGrid.classList.add('filters-hidden');
        updateButtonLabel(false);
        syncGridClassesWithState(false);
      } else {
        // Show filters
        collectionGrid.classList.remove('filters-hidden');
        updateButtonLabel(true);
        syncGridClassesWithState(true);
      }
    });
  })();

  // Custom Load More button styling for Figma design
  (function() {
    function getNextPaginationLink() {
      return document.querySelector('.pagination .pagination-next a');
    }

    function updateLoadMoreButton() {
      const pagination = document.querySelector('.pagination--load-more');
      if (!pagination) return;

      const paginationElement = pagination.closest('.pagination');
      if (!paginationElement) return;

      const totalItems = parseInt(paginationElement.getAttribute('data-paginate-items'), 10);
      const currentOffset = parseInt(paginationElement.getAttribute('data-paginate-offset'), 10);
      const pageSize = parseInt(paginationElement.getAttribute('data-paginate-size'), 10);
      
      if (isNaN(totalItems) || isNaN(currentOffset) || isNaN(pageSize)) return;

      const currentEnd = currentOffset + pageSize;
      const remainingItems = totalItems - currentEnd;
      const nextPageSize = Math.min(pageSize, remainingItems);
      const nextLink = getNextPaginationLink();

      // Update progress text to show "1-20 of 100 products"
      const progressText = pagination.querySelector('.pagination__progress-text');
      if (progressText) {
        const start = currentOffset + 1;
        const end = currentEnd;
        progressText.textContent = `${start}-${end} of ${totalItems} products`;
      }

      // Hide progress bar
      const progressBar = pagination.querySelector('.progress-bar');
      if (progressBar) {
        progressBar.style.display = 'none';
      }

      // Update button text to "VIEW X MORE"
      const buttonText = pagination.querySelector('.btn--load-more--text');
      if (buttonText && nextLink && nextPageSize > 0) {
        buttonText.textContent = `VIEW ${nextPageSize} MORE`;
      } else if (buttonText && !nextLink) {
        buttonText.textContent = 'NO MORE PRODUCTS';
      }

      const button = pagination.querySelector('.btn--load-more');
      if (button) {
        button.disabled = !nextLink;
      }
    }

    // Fallback: if AJAX load-more does not update the grid, navigate to next page URL.
    function bindLoadMoreFallback() {
      const button = document.querySelector('.pagination--load-more .btn--load-more');
      if (!button || button.dataset.loadMoreFallbackBound === 'true') return;

      button.dataset.loadMoreFallbackBound = 'true';
      button.addEventListener('click', function() {
        const nextLink = getNextPaginationLink();
        if (!nextLink) return;

        const nextHref = nextLink.getAttribute('href');
        if (!nextHref) return;

        const initialCount = document.querySelectorAll('.collection-main-body-inner > .grid__item').length;

        window.setTimeout(function() {
          const currentCount = document.querySelectorAll('.collection-main-body-inner > .grid__item').length;
          const currentNextHref = getNextPaginationLink()?.getAttribute('href') || '';
          const gridDidNotUpdate = currentCount === initialCount;
          const paginationDidNotUpdate = currentNextHref === nextHref;

          if (gridDidNotUpdate && paginationDidNotUpdate) {
            window.location.href = nextHref;
          }
        }, 2500);
      });
    }

    // Run on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
          updateLoadMoreButton();
          bindLoadMoreFallback();
        }, 500);
      });
    } else {
      setTimeout(function() {
        updateLoadMoreButton();
        bindLoadMoreFallback();
      }, 500);
    }

    // Watch for dynamically added load more buttons
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.addedNodes.length) {
          mutation.addedNodes.forEach(function(node) {
            if (node.nodeType === 1) {
              if (node.classList && (node.classList.contains('pagination__load-more') || node.classList.contains('pagination'))) {
                setTimeout(function() {
                  updateLoadMoreButton();
                  bindLoadMoreFallback();
                }, 200);
              }
              if (node.querySelector && node.querySelector('.pagination__load-more')) {
                setTimeout(function() {
                  updateLoadMoreButton();
                  bindLoadMoreFallback();
                }, 200);
              }
            }
          });
        }
        // Also check if pagination was replaced
        if (mutation.type === 'childList' && mutation.target.classList && mutation.target.classList.contains('pagination')) {
          setTimeout(function() {
            updateLoadMoreButton();
            bindLoadMoreFallback();
          }, 200);
        }
      });
    });

    const paginationContainer = document.querySelector('.collection_grid .pagination');
    if (paginationContainer) {
      observer.observe(paginationContainer, { childList: true, subtree: true });
    }

    // Watch for changes in the entire collection grid
    const collectionGrid = document.querySelector('.collection_grid');
    if (collectionGrid) {
      observer.observe(collectionGrid, { childList: true, subtree: true });
    }

    // Also update after a delay to catch any late updates
    setInterval(function() {
      if (document.querySelector('.pagination--load-more .pagination__load-more')) {
        const buttonText = document.querySelector('.pagination--load-more .btn--load-more--text');
        if (buttonText && !buttonText.textContent.includes('VIEW') && !buttonText.textContent.includes('MORE')) {
          updateLoadMoreButton();
          bindLoadMoreFallback();
        }
      }
    }, 1000);
  })();

  // Initialize product image swipers for collection page
  (function() {
    function initCollectionProductSwipers() {
      if (typeof initProductSwipers === 'function') {
        initProductSwipers();
      }
    }

    // Run on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(initCollectionProductSwipers, 500);
      });
    } else {
      setTimeout(initCollectionProductSwipers, 500);
    }

    // Watch for dynamically added products (load more)
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.addedNodes.length) {
          mutation.addedNodes.forEach(function(node) {
            if (node.nodeType === 1 && (node.classList && node.classList.contains('grid__item'))) {
              setTimeout(initCollectionProductSwipers, 200);
            }
          });
        }
      });
    });

    const collectionGrid = document.querySelector('.collection-main-body-inner');
    if (collectionGrid) {
      observer.observe(collectionGrid, { childList: true, subtree: true });
    }
  })();
</script>
