{{ 'section-featured-collection.min.css' | asset_url | stylesheet_tag }}

{% style %}
  /* Ensure grid-view-item-image container has proper height */
  .grid-view-item-image {
    position: relative;
    width: 100%;
    display: block;
  }
  
  .grid-view-item-image a.grid__image {
    display: block;
    width: 100%;
    position: relative;
    height: auto;
  }
  
  /* Override image-height--natural for swiper - ensure it works within grid layout */
  .grid-view-item-image a.grid__image.image-height--natural {
    display: block !important;
    grid-template-columns: none !important;
    grid-template-rows: none !important;
    position: relative;
  }
  
  .grid-view-item-image a.grid__image.image-height--natural .grid-view-item-image-swiper {
    grid-column-start: auto !important;
    grid-column-end: auto !important;
    grid-row-start: auto !important;
    grid-row-end: auto !important;
    display: block !important;
    width: 100% !important;
    height: auto;
    padding-bottom: 133.33%;
    aspect-ratio: 3 / 4;
    position: relative;
  }
  
  @supports (aspect-ratio: 3 / 4) {
    .grid-view-item-image a.grid__image.image-height--natural .grid-view-item-image-swiper {
      padding-bottom: 0;
    }
  }
  
  /* Styles for product image swiper pagination dots */
  .grid-view-item-image-swiper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f9f9f9;
    /* Responsive height based on aspect-ratio - iOS compatible */
    aspect-ratio: 3 / 4;
    /* Fallback for older browsers using padding-bottom technique */
    padding-bottom: 133.33%; /* 4/3 = 1.3333 = 133.33% (3:4 vertical format) */
    /* Fix for iOS/Safari */
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  
  /* Override height: 0 if it exists, use aspect-ratio instead */
  @supports (aspect-ratio: 3 / 4) {
    .grid-view-item-image-swiper {
      height: auto;
      padding-bottom: 0;
    }
  }
  
  .grid-view-item-image-swiper .swiper-wrapper {
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Fix for iOS - ensure wrapper takes all space */
    min-height: 100%;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }
  
  /* Ensure wrapper has proper height when parent uses padding-bottom */
  @supports not (aspect-ratio: 3 / 4) {
    .grid-view-item-image-swiper .swiper-wrapper {
      height: 100%;
      /* When parent has padding-bottom, 100% refers to the padding area */
      top: 0;
      bottom: 0;
    }
  }

  .grid-view-item-image-swiper .swiper-slide {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Asegurar que el slide respete los límites */
    overflow: hidden;
  }

  /* Image container with responsive height - same size for all */
  .product-card-image-container {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    /* Ensure container respects slide boundaries */
    box-sizing: border-box;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    /* Prevent overflow - critical to avoid cropping */
    overflow: hidden;
    /* Ensure it doesn't overflow parent container */
    max-width: 100%;
    max-height: 100%;
    min-height: 100%;
  }
  
  /* Ensure responsive-image-wrapper has proper height */
  .product-card-image-container .responsive-image-wrapper {
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    min-height: 100% !important;
  }
  
  /* Ensure swiper slides and images are visible even when swiper is not initialized */
  .grid-view-item-image-swiper {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    min-height: 200px !important; /* Fallback minimum height */
  }
  
  .grid-view-item-image-swiper .swiper-wrapper {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: absolute !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
  }
  
  .grid-view-item-image-swiper .swiper-slide {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    width: 100% !important;
    height: 100% !important;
    flex-shrink: 0 !important;
    min-height: 100% !important;
  }
  
  .grid-view-item-image-swiper .swiper-slide .product-card-image-container {
    min-height: 100% !important;
  }
  
  .grid-view-item-image-swiper .swiper-slide .responsive-image-wrapper {
    width: 100% !important;
    min-height: 100% !important;
    display: flex !important;
    align-items: start !important;
    justify-content: center !important;
  }
  
  .grid-view-item-image-swiper .swiper-slide img,
  .grid-view-item-image-swiper .swiper-slide .responsive-image-wrapper img {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    width: auto !important;
    height: auto !important;
    max-width: 100% !important;
    max-height: 100% !important;
    position: relative !important;
    z-index: 1 !important;
  }
  
  /* Force active slide to be visible */
  .grid-view-item-image-swiper .swiper-slide-active {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  
  .grid-view-item-image-swiper .swiper-slide-active img {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  /* Ensure images are NOT cropped - all with the same height */
  /* Maximum specificity to override inline styles */
  .grid-view-item-image-swiper .swiper-slide img,
  .grid-view-item-image-swiper .swiper-slide img.theme-img,
  .grid-view-item-image-swiper .swiper-slide img.js,
  .product-card-image-container img,
  .product-card-image-container img.theme-img,
  .product-card-image-container img.js {
    width: auto !important;
    height: auto !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important; /* Keep full product image visible */
    -webkit-object-fit: contain !important; /* Fix for Safari/iOS */
    object-position: center !important; /* Overrides inline styles */
    -webkit-object-position: center !important; /* Fix for Safari/iOS */
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
    /* Ensure image doesn't overflow container */
    box-sizing: border-box;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .grid-view-item-image-swiper .swiper-slide picture,
  .grid-view-item-image-swiper .swiper-slide .responsive-image__wrapper {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    /* Crítico: prevenir que se salga del contenedor */
    overflow: hidden !important;
    box-sizing: border-box;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .grid-view-item-image-swiper .swiper-slide picture img,
  .grid-view-item-image-swiper .swiper-slide .responsive-image__wrapper img,
  .grid-view-item-image-swiper .swiper-slide .responsive-image-wrapper img,
  .product-card-image-container .responsive-image-wrapper img,
  .product-card-image-container picture img {
    width: auto !important;
    height: auto !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important; /* Keep full product image visible */
    -webkit-object-fit: contain !important; /* Fix for Safari/iOS */
    object-position: center !important; /* Overrides inline styles */
    -webkit-object-position: center !important; /* Fix for Safari/iOS */
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
    /* Ensure image doesn't overflow */
    box-sizing: border-box;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  /* Asegurar que todos los elementos de imagen respeten el contenedor */
  .grid-view-item-image-swiper .swiper-slide * {
    max-width: 100% !important;
    max-height: 100% !important;
    box-sizing: border-box;
  }

  /* Mejoras para mobile - prevenir interferencia con swiper principal */
  @media screen and (max-width: 749px) {
    .grid-view-item-image-swiper {
      touch-action: pan-y pinch-zoom;
      -webkit-overflow-scrolling: touch;
      /* Mantener aspect-ratio responsivo en mobile */
      padding-bottom: 133.33%; /* 4/3 ratio */
      /* Fix adicional para iOS */
      -webkit-transform: translateZ(0);
      transform: translateZ(0);
    }

    .grid-view-item-image-swiper .swiper-wrapper {
      touch-action: pan-x;
      will-change: transform;
      /* Fix para iOS - asegurar altura completa */
      min-height: 100%;
      height: 100% !important;
    }

    .grid-view-item-image-swiper .swiper-slide {
      touch-action: pan-x;
      user-select: none;
      -webkit-user-select: none;
      /* Fix para iOS - asegurar altura completa */
      min-height: 100%;
      height: 100% !important;
    }

    /* Asegurar que el área táctil esté bien definida */
    .product-card-image-container {
      touch-action: pan-x;
      -webkit-tap-highlight-color: transparent;
      /* Asegurar que respete los límites del slide */
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
    }

    /* Asegurar contain en mobile también */
    .grid-view-item-image-swiper .swiper-slide img,
    .grid-view-item-image-swiper .swiper-slide picture img,
    .grid-view-item-image-swiper .swiper-slide .responsive-image__wrapper img {
      object-fit: contain !important;
      -webkit-object-fit: contain !important; /* Fix para Safari/iOS */
      object-position: center;
      -webkit-object-position: center; /* Fix para Safari/iOS */
      max-width: 100%;
      max-height: 100%;
      /* Fix para iOS - prevenir overflow */
      -webkit-transform: translateZ(0);
      transform: translateZ(0);
    }
  }

  /* Fixes específicos para iOS/Safari */
  @supports (-webkit-touch-callout: none) {
    .grid-view-item-image-swiper {
      /* iOS Safari específico */
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
    }

    .grid-view-item-image-swiper .swiper-wrapper {
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
      height: 100% !important;
      min-height: 100% !important;
    }

    .grid-view-item-image-swiper .swiper-slide {
      height: 100% !important;
      min-height: 100% !important;
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
    }

    .product-card-image-container {
      position: relative !important;
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
    }

    .grid-view-item-image-swiper .swiper-slide {
      overflow: hidden !important;
    }

    .grid-view-item-image-swiper .swiper-slide img,
    .grid-view-item-image-swiper .swiper-slide picture img,
    .grid-view-item-image-swiper .swiper-slide .responsive-image__wrapper img {
      max-width: 100% !important;
      max-height: 100% !important;
      object-fit: contain !important;
      -webkit-object-fit: contain !important;
      width: auto !important;
      height: auto !important;
    }
  }

  /* Tablet */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .grid-view-item-image-swiper {
      padding-bottom: 133.33%; /* Mantener mismo ratio */
    }
  }

  /* Desktop - mantener aspect-ratio responsivo */
  @media screen and (min-width: 990px) {
    .grid-view-item-image-swiper {
      padding-bottom: 133.33%; /* Mantener mismo ratio en todos los tamaños */
    }
  }

  /* Preview del siguiente producto en mobile */
  @media screen and (max-width: 749px) {
    .product-grid--slider-enabled grid-slider.swiper {
      overflow: visible !important;
      padding-right: 0;
    }
    
    .product-grid--slider-enabled .swiper-wrapper {
      padding-right: 20px;
    }
    
    /* Mobile slider slides - dynamic width based on slides per view */
    /* The grid-slider component will handle the width calculation via JavaScript */
    /* This CSS ensures proper spacing and preview visibility */
    .product-grid--slider-enabled .swiper-slide {
      flex-shrink: 0;
    }
    
    /* Asegurar que el contenedor permita ver el preview */
    .product-grid--slider-enabled .homepage-featured-content-wrapper {
      overflow: visible;
    }
    
    .product-grid--slider-enabled .product-grid--wrapper {
      overflow: visible;
    }
  }
{% endstyle %}

{% liquid 
  assign wrapper_classes = ''
  assign featured_collection = section.settings.collection

  if section.settings.layout_style == 'slider' and settings.hover_navigation_desktop == 'above'
    if section.settings.title != blank or section.settings.description != blank
      assign wrapper_classes = 'remove--spacing'
    endif
  endif

  assign header_has_content = false
  if section.settings.title != blank or section.settings.description != blank
    assign header_has_content = true
  endif

  assign header_and_button_centered = false
  if section.settings.section_header_alignment == 'center' and section.settings.button_alignment == 'center'
    assign header_and_button_centered = true
  endif

  if section.settings.button_position == 'above_products' and header_and_button_centered == false
    assign header_button_align_class = ''
    if section.settings.section_header_alignment == 'left' and section.settings.button_alignment == 'right'
      assign header_button_align_class = 'header-left-button-right'
    endif

    if section.settings.section_header_alignment == 'right' and section.settings.button_alignment == 'left'
      assign header_button_align_class = 'header-right-button-left'
    endif
  endif 
%}

{% if section.settings.override_button_colors %}
  {% assign grid_item_id = 'grid-item--' | append: section.id %}
  {% render 'button-color-overrides' with
    id: grid_item_id,
    style: settings.quick_shop_button_style,
    text_color: section.settings.button_text_color,
    background_color: section.settings.button_background_color
  %}
{% endif %}

{% comment %} Load scripts based on content type {% endcomment %}
{% if section.settings.content_type == 'recommendations' %}
  {% unless request.visual_preview_mode %}
    <safe-load-scripts class="hidden">
      <script src="{{ 'component-product-recommendations.js' | asset_url }}" defer="defer" type="module" data-flow-load-key="product-recommendations"></script>
    </safe-load-scripts>
  {% endunless %}
{% elsif section.settings.content_type == 'recently-viewed' %}
  <safe-load-scripts class="hidden">
    <script src="{{ 'component-recently-viewed-products.js' | asset_url }}" type="module" defer="defer" data-flow-load-key="component-recently-viewed"></script>
  </safe-load-scripts>
{% endif %}

{% if section.settings.show_view_all and section.settings.content_type == 'collection' %}
  {% capture view_all_button %}
    {%- liquid
      assign view_all_label = 'Shop Now'
      assign view_all_aria_label = 'collections.general.view_all_label' | t: collection_name: featured_collection.title
      assign view_all_id = 'view-all--' | append: section.id
      assign view_all_classes = 'text-' | append: section.settings.button_alignment | append: ' show-view-all--button'
      assign view_all_btn_attributes = ''

      if section.settings.button_position == 'above_products'
        assign animation_order = '2'
        if section.settings.title != blank and section.settings.description != blank
          assign animation_order = '3'
        elsif section.settings.title == blank and section.settings.description == blank
          assign animation_order = '1'
        endif

        assign view_all_btn_attributes = 'data-animate data-animate-order="' | append: animation_order | append: '"'
      else
        assign animation_order = '4'
        assign view_all_btn_attributes = 'data-animate data-animate-order="' | append: animation_order | append: '"'
      endif
    -%}

    {% if section.settings.override_button_colors %}
      {% render 'button-color-overrides' with
        id: view_all_id,
        style: section.settings.buttons_style,
        text_color: section.settings.button_text_color,
        background_color: section.settings.button_background_color
      %}
    {% endif %}
    
    {% render 'dynamic-section-button' with
      id: view_all_id,
      link: featured_collection.url,
      label: view_all_label,
      aria_label: view_all_aria_label,
      style: section.settings.buttons_style,
      div_classes: view_all_classes,
      attributes: view_all_btn_attributes
    %}
  {% endcapture %}
{% endif %}

<div
  class="wrapper-spacing--v wrapper-spacing--h color-scheme--{{ section.settings.colors }}{% if request.visual_preview_mode %} section-preview{% else %} show-on-scroll{% endif %}{% if section.settings.layout_style == 'slider' %} slider-nav--{{ settings.hover_navigation_desktop }}{% endif %}{% if header_has_content %} {{ header_button_align_class }}{% endif %}"
  data-wetheme-section-type="collection--featured-collection" 
  data-wetheme-section-id="{{ section.id }}"
  style="--padding-section-top-mobile: {{ section.settings.section_padding_top_mobile }}px; --padding-section-bottom-mobile: {{ section.settings.section_padding_bottom_mobile }}px; --padding-section-top: {{ section.settings.section_padding_top }}px; --padding-section-bottom: {{ section.settings.section_padding_bottom }}px;"
>
  <div class="width--content">
    {% comment %} Section title and description {% endcomment %}
    <div class="section-header-wrapper{% if header_has_content %} header-align--{{ section.settings.section_header_alignment }}{% endif %}">
      {% render 'dynamic-section-header' with section_title: section.settings.title, section_description: section.settings.description, wrapper_classes: wrapper_classes, alignment: section.settings.section_header_alignment %}

      {% if section.settings.button_position == 'above_products' %}
        {{ view_all_button }}
      {% endif %}
    </div>

    <div class="homepage-indiv-section-wrapper grid--full homepage-featured-content-wrapper
    position-btn-layout__{{ settings.hover_navigation_desktop }}
    ">
      {% liquid 
        assign collection = collections[section.settings.collection]
        assign tablet_item_width = 'medium--one-third'

        case section.settings.grid-desktop
          when 2
            assign desktop_item_width = 'large--one-half'
            assign tablet_item_width = 'medium--one-half'
          when 3
            assign desktop_item_width = 'large--one-third'
          when 4
            assign desktop_item_width = 'large--one-quarter'
          when 5
            assign desktop_item_width = 'large--one-fifth'
          when 6
            assign desktop_item_width = 'large--one-sixth'
        endcase

        # Handle mobile grid width based on rounded value (for CSS classes)
        assign mobile_grid_value = section.settings.grid-mobile | round
        case mobile_grid_value
          when 1
            assign mobile_item_width = 'small--one-whole'
          when 2
            assign mobile_item_width = 'small--one-half'
          when 3
            assign mobile_item_width = 'small--one-third'
          else
            # Default to one-half if value is between 2 and 3
            if mobile_grid_value >= 2
              assign mobile_item_width = 'small--one-half'
            else
              assign mobile_item_width = 'small--one-whole'
            endif
        endcase

        assign grid_item_width = desktop_item_width | append: ' ' | append: tablet_item_width | append: ' ' | append: mobile_item_width
        assign product_limit = section.settings.products_to_show
        
        # Use the range value directly for slider slides per view (supports decimals)
        if section.settings.layout_style == 'slider'
          # Use the value directly from the range slider (already supports decimals like 1.4, 2.3, etc.)
          assign mobile_slides_per_view = section.settings.grid-mobile
        else
          # For grid layout, round to nearest integer
          assign mobile_slides_per_view = section.settings.grid-mobile | round
        endif
      %}

      {% comment %} Render based on content type {% endcomment %}
      {% if section.settings.content_type == 'recommendations' %}
        {% comment %} Product Recommendations {% endcomment %}
        <product-recommendations
          class="product-recommendations"
          data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
          data-wetheme-section-type="collection--featured-collection"
          data-wetheme-section-id="{{ section.id }}"
        >
          {%- if recommendations.performed and recommendations.products_count > 0 or request.visual_preview_mode -%}
            <div class="product-page-related-products product-sticker-stop width--content">
              <div data-grid-slider-wrapper>
                <div class="product-grid--wrapper{% if section.settings.layout_style == 'slider' %} product-grid--slider-enabled{% endif %}">
                  {%- if section.settings.layout_style == 'slider' -%}
                    <safe-load-scripts class="hidden">
                      <script src="{{ 'component-grid-slider.js' | asset_url }}" defer="defer" type="module" data-flow-load-key="grid-slider"></script>
                    </safe-load-scripts>

                    <!-- navigation -->
                    {% assign navigation_id = 'navigation--' | append: section.id %}
                    <div class="swiper-btn--wrapper small-hide swiper-btn-layout__{{ settings.hover_navigation_desktop }}">
                      <div class="swiper-button--prev btn dynamic-section-button--{{ navigation_id }} swiper-button--grid-slider">
                        {% render 'theme-icon', icon: 'chevron_left_long' %}
                      </div>
                      <div class="swiper-button--next btn dynamic-section-button--{{ navigation_id }} swiper-button--grid-slider">
                        {% render 'theme-icon', icon: 'chevron_right_long' %}
                      </div>
                    </div>
                    {% if section.settings.override_button_colors %}
                      {% render 'button-color-overrides' with
                        id: navigation_id,
                        style: 'filled',
                        text_color: section.settings.button_text_color,
                        background_color: section.settings.button_background_color
                      %}
                    {% endif %}

                    <grid-slider 
                      class="swiper"
                      data-slides-per-view-desktop="{{ section.settings.grid-desktop }}"
                      data-slides-per-view-mobile="{{ mobile_slides_per_view | round: 1 }}"
                      data-product-limit="{{ product_limit }}"
                      data-grid-spacing-desktop="{{ settings.grid_spacing }}"
                      data-grid-spacing-mobile="{{ settings.grid_spacing | times: 0.75 }}"
                      data-animate-overflow-container
                    >
                      <div class="swiper-wrapper">
                  {%- endif -%}

                  {% unless request.visual_preview_mode %}
                    {%- for product in recommendations.products -%}
                      {%- unless grid_item_width -%}
                        {%- assign grid_item_width = 'large--one-third medium--one-half' -%}
                      {%- endunless -%}
                      {% capture animation_attr %}
                        data-animate
                        data-animate-order="{% render 'block-animation-offset', 
                          title: section.settings.title, 
                          description: section.settings.description, 
                          base: forloop.index 
                        %}"
                        data-animate-overflow-item
                      {% endcapture %}

                      <div class="grid__item{% if section.settings.layout_style == 'slider' %} swiper-slide {{ grid_item_width }}{% else %} {{ grid_item_width }}{% endif %}" {{ animation_attr }}>
                        <div class="grid-view-item">
                          {% assign badge_anim_order = forloop.index | plus: 2 %}
                          {% render 'grid-view-item',
                            product: product,
                            collection: null,
                            enable_badges: settings.show_badges,
                            grid_count_desktop: section.settings.grid-desktop,
                            grid_count_mobile: section.settings.grid-mobile,
                            section_color_scheme: section.settings.colors,
                            section_id: section.id,
                            badge_anim_order: badge_anim_order,
                            show_highlight: section.settings.show_highlight,
                            highlight_icon: section.settings.highlight_icon,
                            highlight_custom_icon: section.settings.highlight_custom_icon,
                            highlight_heading: section.settings.highlight_heading,
                            highlight_reference: section.settings.highlight_reference,
                            highlight_text_color: section.settings.highlight_text_color,
                            highlight_background_color: section.settings.highlight_background_color,
                            highlight_alignment: section.settings.highlight_alignment,
                            highlight_font_size: section.settings.highlight_font_size,
                            highlight_collapsible_tab: section.settings.highlight_collapsible_tab,
                            highlight_open_close_icon: section.settings.highlight_open_close_icon,
                            highlight_button_borders: section.settings.highlight_button_borders %}
                        </div>
                      </div>
                    {%- endfor -%}
                  {% endunless %}

                  {% if request.visual_preview_mode %}
                    {% for i in (1..section.settings.products_to_show) %}
                      {% capture svg_index %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                      {% capture svg_index_reversed %}{% cycle 6, 5, 4, 3, 2, 1 %}{% endcapture %}
                      {% if section.settings.layout_style == 'slider' %}
                        <div class="grid__item {{ grid_item_width }} swiper-slide">
                      {% else %}
                        <div class="grid__item {{ grid_item_width }} featured-product--grid-item">
                      {% endif %}
                        {% render 'grid-view-item-placeholder',
                          svg_index: svg_index,
                          svg_index_reversed: svg_index_reversed,
                          show_highlight: section.settings.show_highlight,
                          highlight_icon: section.settings.highlight_icon,
                          highlight_custom_icon: section.settings.highlight_custom_icon,
                          highlight_heading: section.settings.highlight_heading,
                          highlight_reference: section.settings.highlight_reference,
                          highlight_text_color: section.settings.highlight_text_color,
                          highlight_background_color: section.settings.highlight_background_color,
                          highlight_alignment: section.settings.highlight_alignment,
                          highlight_font_size: section.settings.highlight_font_size,
                          highlight_collapsible_tab: section.settings.highlight_collapsible_tab,
                          highlight_open_close_icon: section.settings.highlight_open_close_icon,
                          highlight_button_borders: section.settings.highlight_button_borders %}
                      </div>
                    {% endfor %}
                  {% endif %}

                  {%- if section.settings.layout_style == 'slider' -%}
                      </div>
                    </grid-slider>

                    <!-- pagination -->
                    <div class="swiper-pagination"></div>

                    <!-- scrollbar -->
                    {% if section.settings.show_scrollbar %}
                    <div class="swiper-scrollbar large-hide"></div>
                    {% endif %}
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </product-recommendations>

      {% elsif section.settings.content_type == 'recently-viewed' %}
        {% comment %} Recently Viewed Products {% endcomment %}
        <div 
          data-recently-viewed-wrapper
          style="{% unless request.visual_preview_mode %}display: none;{% endunless %}"
        >
          <recently-viewed-products
            class="recently-viewed-products collection width--content"
            data-wetheme-section-type="collection--featured-collection"
            data-wetheme-section-id="{{ section.id }}"
            data-layout-style="{{ section.settings.layout_style }}"
            data-layout-classes="{{ grid_item_width }}"
            data-products-to-show="{{ section.settings.products_to_show }}"
            data-quick-shop-desktop-enabled="{{ settings.enable_quick_shop_desktop }}"
            data-quick-shop-mobile-enabled="{{ settings.enable_quick_shop_mobile }}"
            data-is-preview-mode="{{ request.visual_preview_mode }}"
            {% if request.page_type == 'product' %}exclude-id="{{ product.id }}"{% endif %}
          >
            <div class="wrapper" role="main" data-grid-slider-wrapper>
              <div class="product-grid--wrapper{% if section.settings.layout_style == 'slider' %} product-grid--slider-enabled{% endif %}"{% if section.settings.layout_style == 'grid' %} id="recently-viewed-products"{% endif %}>
                {%- if section.settings.layout_style == 'slider' -%}
                  <safe-load-scripts class="hidden">
                    <script src="{{ 'component-grid-slider.js' | asset_url }}" defer="defer" type="module" data-flow-load-key="grid-slider"></script>
                  </safe-load-scripts>

                  <!-- navigation -->
                  {% assign navigation_id = 'navigation--' | append: section.id %}
                  <div class="swiper-btn--wrapper small-hide swiper-btn-layout__{{ settings.hover_navigation_desktop }}">
                    <div class="swiper-button--prev btn dynamic-section-button--{{ navigation_id }} swiper-button--grid-slider">
                      {% render 'theme-icon', icon: 'chevron_left_long' %}
                    </div>
                    <div class="swiper-button--next btn dynamic-section-button--{{ navigation_id }} swiper-button--grid-slider">
                      {% render 'theme-icon', icon: 'chevron_right_long' %}
                    </div>
                  </div>
                  {% if section.settings.override_button_colors %}
                    {% render 'button-color-overrides' with
                      id: navigation_id,
                      style: 'filled',
                      text_color: section.settings.button_text_color,
                      background_color: section.settings.button_background_color
                    %}
                  {% endif %}

                  <grid-slider 
                    class="swiper"
                    data-slides-per-view-desktop="{{ section.settings.grid-desktop }}"
                    data-slides-per-view-mobile="{{ mobile_slides_per_view | round: 1 }}"
                    data-product-limit="{{ product_limit }}"
                    data-grid-spacing-desktop="{{ settings.grid_spacing }}"
                    data-grid-spacing-mobile="{{ settings.grid_spacing | times: 0.75 }}"
                    data-animate-overflow-container
                  >
                    <div class="swiper-wrapper" id="recently-viewed-products">
                {%- endif -%}

                {% if request.visual_preview_mode %}
                  {% for i in (1..section.settings.products_to_show) %}
                    {% capture svg_index %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                    {% capture svg_index_reversed %}{% cycle 6, 5, 4, 3, 2, 1 %}{% endcapture %}
                    {% if section.settings.layout_style == 'slider' %}
                      <div class="grid__item {{ grid_item_width }} swiper-slide">
                    {% else %}
                      <div class="grid__item {{ grid_item_width }} featured-product--grid-item">
                    {% endif %}
                      {% render 'grid-view-item-placeholder',
                        svg_index: svg_index,
                        svg_index_reversed: svg_index_reversed,
                        show_highlight: section.settings.show_highlight,
                        highlight_icon: section.settings.highlight_icon,
                        highlight_custom_icon: section.settings.highlight_custom_icon,
                        highlight_heading: section.settings.highlight_heading,
                        highlight_reference: section.settings.highlight_reference,
                        highlight_text_color: section.settings.highlight_text_color,
                        highlight_background_color: section.settings.highlight_background_color,
                        highlight_alignment: section.settings.highlight_alignment,
                        highlight_font_size: section.settings.highlight_font_size,
                        highlight_collapsible_tab: section.settings.highlight_collapsible_tab,
                        highlight_open_close_icon: section.settings.highlight_open_close_icon,
                        highlight_button_borders: section.settings.highlight_button_borders %}
                    </div>
                  {% endfor %}
                {% elsif search.performed and search.results_count > 0 %}
                  {%- assign parsed_terms = search.terms | split: ' OR ' -%}
                  {%- for parsed_term in parsed_terms -%}
                    {%- assign id = parsed_term | split: 'id:' | last | times: 1 -%}
                    {%- assign product = search.results | where: 'id', id | first -%}
                    {% capture animation_attr %}
                      data-animate
                      data-animate-order="{% render 'block-animation-offset', 
                        title: section.settings.title, 
                        description: section.settings.description, 
                        base: forloop.index 
                      %}"
                      data-animate-overflow-item
                    {% endcapture %}

                    {%- if product != blank -%}
                      {% if section.settings.layout_style == 'slider' %}
                        <div class="grid__item {{ grid_item_width }} swiper-slide" {{ animation_attr }}>
                      {% else %}
                        <div class="grid__item {{ grid_item_width }} featured-product--grid-item" {{ animation_attr }}>
                      {% endif %}
                        {% assign badge_anim_order = forloop.index | plus: 2 %}
                        {% render 'grid-view-item',
                          product: product,
                          collection: collection,
                          enable_badges: settings.show_badges,
                          grid_count_desktop: section.settings.grid-desktop,
                          grid_count_mobile: section.settings.grid-mobile,
                          section_id: section.id,
                          badge_anim_order: badge_anim_order,
                          show_highlight: section.settings.show_highlight,
                          highlight_icon: section.settings.highlight_icon,
                          highlight_custom_icon: section.settings.highlight_custom_icon,
                          highlight_heading: section.settings.highlight_heading,
                          highlight_reference: section.settings.highlight_reference,
                          highlight_text_color: section.settings.highlight_text_color,
                          highlight_background_color: section.settings.highlight_background_color,
                          highlight_alignment: section.settings.highlight_alignment,
                          highlight_font_size: section.settings.highlight_font_size,
                          highlight_collapsible_tab: section.settings.highlight_collapsible_tab,
                          highlight_open_close_icon: section.settings.highlight_open_close_icon,
                          highlight_button_borders: section.settings.highlight_button_borders %}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {% endif %}

                {%- if section.settings.layout_style == 'slider' -%}
                    </div>
                  </grid-slider>

                  <!-- pagination -->
                  <div class="swiper-pagination"></div>

                  <!-- scrollbar -->
                  {% if section.settings.show_scrollbar %}
                  <div class="swiper-scrollbar large-hide"></div>
                  {% endif %}
                {%- endif -%}
              </div>
            </div>
          </recently-viewed-products>
        </div>

      {% else %}
        {% comment %} Collection (default) {% endcomment %}
        <div 
          class="grid-uniform product-grid--wrapper{% if section.settings.layout_style == 'slider' %} product-grid--slider-enabled{% endif %}"
          {%- if section.settings.layout_style == 'slider' -%} data-grid-slider-wrapper{%- endif -%}
        >
          {%- if section.settings.layout_style == 'slider' -%}
            <safe-load-scripts class="hidden">
              <script src="{{ 'component-grid-slider.js' | asset_url }}" defer="defer" type="module" data-flow-load-key="grid-slider"></script>
            </safe-load-scripts>

            <!-- navigation -->
            {% assign navigation_id = 'navigation--' | append: section.id %}
            <div class="swiper-btn--wrapper small-hide swiper-btn-layout__{{ settings.hover_navigation_desktop }}">
              <div class="swiper-button--prev btn dynamic-section-button--{{ navigation_id }} swiper-button--grid-slider">
                {% render 'theme-icon', icon: 'chevron_left_long' %}
              </div>
              <div class="swiper-button--next btn dynamic-section-button--{{ navigation_id }} swiper-button--grid-slider">
                {% render 'theme-icon', icon: 'chevron_right_long' %}
              </div>
            </div>
            {% if section.settings.override_button_colors %}
              {% render 'button-color-overrides' with
                id: navigation_id,
                style: 'filled',
                text_color: section.settings.button_text_color,
                background_color: section.settings.button_background_color
              %}
            {% endif %}

            <grid-slider 
              class="swiper"
              data-slides-per-view-desktop="{{ section.settings.grid-desktop }}"
              data-slides-per-view-mobile="{{ mobile_slides_per_view | round: 1 }}"
              data-product-limit="{{ product_limit }}"
              data-grid-spacing-desktop="{{ settings.grid_spacing }}"
              data-grid-spacing-mobile="{{ settings.grid_spacing | times: 0.75 }}"
              data-animate-overflow-container
            >
              <div class="swiper-wrapper">
          {%- endif -%}
          {% for product in collection.products limit: product_limit %}
            
            {% comment %}
              Set the default grid_item_width if no variable is set
            {% endcomment %}
            {% unless grid_item_width %}
              {% assign grid_item_width = 'large--one-third medium--one-half' %}
            {% endunless %}

            {% if section.settings.layout_style == 'slider' %}
              <div
                class="grid__item {{ grid_item_width }} swiper-slide"
                data-animate
                data-animate-order="{% render 'block-animation-offset', 
                  title: section.settings.title, 
                  description: section.settings.description, 
                  base: forloop.index
                %}"
                data-animate-overflow-item
              >
            {% else %}
              <div
                class="grid__item {{ grid_item_width }} featured-product--grid-item"
                data-animate
                data-animate-order="{% render 'block-animation-offset', 
                  title: section.settings.title, 
                  description: section.settings.description, 
                  base: forloop.index
                %}"
              >
            {% endif %}
              {% assign badge_anim_order = forloop.index | plus: 2 %}
              {% render 'grid-view-item',
                product: product,
                collection: collection,
                enable_badges: settings.show_badges,
                grid_count_desktop: section.settings.grid-desktop,
                grid_count_mobile: section.settings.grid-mobile,
                section_color_scheme: section.settings.colors,
                section_id: section.id,
                badge_anim_order: badge_anim_order,
                show_highlight: section.settings.show_highlight,
                highlight_icon: section.settings.highlight_icon,
                highlight_custom_icon: section.settings.highlight_custom_icon,
                highlight_heading: section.settings.highlight_heading,
                highlight_reference: section.settings.highlight_reference,
                highlight_text_color: section.settings.highlight_text_color,
                highlight_background_color: section.settings.highlight_background_color,
                highlight_alignment: section.settings.highlight_alignment,
                highlight_font_size: section.settings.highlight_font_size,
                highlight_collapsible_tab: section.settings.highlight_collapsible_tab,
                highlight_open_close_icon: section.settings.highlight_open_close_icon,
                highlight_button_borders: section.settings.highlight_button_borders
              %}
            </div>

          {% else %}
            {% for i in (1..product_limit) %}
              {% capture svg_index %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
              {% capture svg_index_reversed %}{% cycle 6, 5, 4, 3, 2, 1 %}{% endcapture %}
              {% if section.settings.layout_style == 'slider' %}
                <div
                  class="grid__item {{ grid_item_width }} swiper-slide"
                  data-animate
                  data-animate-order="{% render 'block-animation-offset', 
                    title: section.settings.title, 
                    description: section.settings.description, 
                    base: forloop.index
                  %}"
                  data-animate-overflow-item
                >
              {% else %}
                <div
                  class="grid__item {{ grid_item_width }} featured-product--grid-item"
                  data-animate
                  data-animate-order="{% render 'block-animation-offset', 
                    title: section.settings.title, 
                    description: section.settings.description, 
                    base: forloop.index
                  %}"
                >
              {% endif %}
                {% assign badge_anim_order = forloop.index | plus: 2 %}
                {% render 'grid-view-item-placeholder',
                  svg_index: svg_index,
                  svg_index_reversed: svg_index_reversed,
                  section_color_scheme: section.settings.colors,
                  section_id: section.id,
                  badge_anim_order: badge_anim_order,
                  show_highlight: section.settings.show_highlight,
                  highlight_icon: section.settings.highlight_icon,
                  highlight_custom_icon: section.settings.highlight_custom_icon,
                  highlight_heading: section.settings.highlight_heading,
                  highlight_reference: section.settings.highlight_reference,
                  highlight_text_color: section.settings.highlight_text_color,
                  highlight_background_color: section.settings.highlight_background_color,
                  highlight_alignment: section.settings.highlight_alignment,
                  highlight_font_size: section.settings.highlight_font_size,
                  highlight_collapsible_tab: section.settings.highlight_collapsible_tab,
                  highlight_open_close_icon: section.settings.highlight_open_close_icon,
                  highlight_button_borders: section.settings.highlight_button_borders
                %}
              </div>
            {% endfor %}
          {% endfor %}
        {%- if section.settings.layout_style == 'slider' -%}
            </div>
          </grid-slider>

          <!-- pagination -->
          <div class="swiper-pagination"></div>

          <!-- scrollbar -->
          {% if section.settings.show_scrollbar %}
          <div class="swiper-scrollbar large-hide"></div>
          {% endif %}
        {%- endif -%}
      </div>
      {% endif %}

      {% if section.settings.button_position == 'below_products' and section.settings.content_type == 'collection' %}
          {{ view_all_button }}
      {% endif %}
    </div>
  </div>
</div>

