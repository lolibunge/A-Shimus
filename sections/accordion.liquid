{% liquid
  assign width_class = ''
  unless section.settings.section_width == 'full-width'
    assign width_class = 'width--' | append: section.settings.section_width
  endunless
%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_background_color }};
    color: {{ section.settings.section_text_color }};
    padding: 72px 48px;
  }

    #shopify-section-{{ section.id }} .accordion--faq .accordion-content {
      padding-bottom: 24px;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .accordion--faq .accordion-content {
      margin-bottom: 0;
    }

    .accordion--faq.section-two_column .accordion-content{
      margin-bottom: 24px !important;
    }
    .accordion--faq.section-two_column .collapsible-tab.open .collapsible-content {
      margin-top:16px;
    }

    #shopify-section-{{ section.id }} .accordion--faq .collapsible-tab.open .collapsible-content {
      height:fit-content !important;
    }

    #shopify-section-{{ section.id }} .accordion--faq .accordion-content .collapsible-content {
      height:0;
    }

    #shopify-section-{{ section.id }} .accordion--faq .accordion-content .collapsible-content .content,
    #shopify-section-{{ section.id }} .accordion--faq .accordion-content .collapsible-content .content .richtext-block {
      margin: 0 !important;
    }

  #shopify-section-{{ section.id }} .accordion--faq .accordion-content:not(:first-child):last-child {
      margin-bottom: 0 !important;
    }

    #shopify-section-{{ section.id }} .accordion--faq  .section-title {
      font-family: IvyPresto Text;
      margin: 0;
      font-size: 36px;
      line-height: normal;
      font-weight: 300;
    }

    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} {
        padding: 60px 24px;
      }

      #shopify-section-{{ section.id }} .accordion--faq  .section-title {
        font-size: 24px;
      }
    }
</style>

<section
  class="accordion--faq section-{{ section.settings.column_layout }} {% if request.visual_preview_mode %} section-preview{% else %} show-on-scroll{% endif %}"
  data-wetheme-section-type="accordion--faq"
  data-wetheme-section-id="{{ section.id }}"
  style="--padding-section-top: {{ section.settings.section_padding_top }}px; --padding-section-bottom: {{ section.settings.section_padding_bottom }}px;"
>
  {% comment %} Section title and description {% endcomment %}
  {% render 'dynamic-section-header' with section_title: section.settings.title, section_description: section.settings.description, alignment: section.settings.section_header_alignment, wrapper_classes: width_class %}

  <div
    {% unless section.settings.section_width == 'full-width' %}
      class="{{ width_class }}"
    {% endunless %}
  >
    {% for block in section.blocks %}
      {% assign content = block.settings.text %}
      {% if block.settings.page.content %}
        {% assign content = content | append: block.settings.page.content %}
      {% endif %}

      {% unless content == blank %}
        <div
          class="accordion-content"
          data-animate
          data-animate-order="
            {% render 'block-animation-offset',
              title: section.settings.title,
              description: section.settings.description,
              base: forloop.index
            %}
          "
          {{ block.shopify_attributes }}
        >
          {% render 'collapsible-tab',
            icon: 'none',
            custom_icon: false,
            heading: block.settings.question,
            content: content,
            open_close_icon: section.settings.faq_icon,
            open_by_default: block.settings.open_by_default,
            block_id: block.id
          %}
        </div>
      {% endunless %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.accordion.name",
  "class": "accordion-faq",
  "settings": [
    {
      "type": "header",
      "content": "t:all.Heading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:all.Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:all.Description"
    },
    {
      "type": "text_alignment",
      "id": "section_header_alignment",
      "label": "t:all.Alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:all.Content"
    },
    {
      "type": "select",
      "id": "column_layout",
      "label": "Column layout",
      "options": [
        {
          "value": "",
          "label": "One column"
        },
        {
          "value": "two_column",
          "label": "Two column"
        }
      ],
      "default": ""
    },
    {
      "type": "radio",
      "id": "faq_icon",
      "label": "t:all.Open_Close_icon_style",
      "options": [
        {
          "value": "plus_minus",
          "label": "t:all.Plus_minus"
        },
        {
          "value": "caret",
          "label": "t:all.Caret"
        }
      ],
      "default": "plus_minus"
    },
    {
      "type": "header",
      "content": "t:all.Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:all.Width",
      "options": [
        {
          "value": "narrow",
          "label": "t:all.Narrow"
        },
        {
          "value": "content",
          "label": "t:all.Content_width"
        },
        {
          "value": "full-width",
          "label": "t:all.Full_width"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "t:all.Color"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "Section text color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "tab_content",
      "name": "t:sections.accordion.blocks.tab_content.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.template--product.blocks.collapsible-tab.settings.info.content"
        },
        {
          "type": "header",
          "content": "t:sections.template--product.blocks.collapsible-tab.settings.tab_heading.label"
        },
        {
          "type": "text",
          "id": "question",
          "label": "t:all.Heading",
          "default": "Place your question or heading here"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "t:sections.template--product.blocks.collapsible-tab.settings.open_by_default.label",
          "default": false
        },
        {
          "type": "header",
          "content": "t:all.Content"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:all.Text",
          "default": "<p>Here you can place an explanation or answer to the question.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:all.Page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.accordion.presets.name",
      "blocks": [
        {
          "type": "tab_content"
        },
        {
          "type": "tab_content"
        },
        {
          "type": "tab_content"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  }
}
{% endschema %}
